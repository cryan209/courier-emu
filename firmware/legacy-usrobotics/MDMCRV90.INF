HKR,,EnumPropPages,,"modemui.dll,EnumPropPages"
HKR,,FriendlyDriver,,unimodem.vxd
HKR,,InactivityScale,1,3c,00,00,00
HKR,,InactivityFormat,, "minutes"
HKR,,PortSubClass,1,02
HKR,,Reset,,"ATZ<cr>"
HKR,,CompatibilityFlags, 1, 01, 00, 00, 00
