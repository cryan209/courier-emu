; U.S. Robotics Access Corp.
; INF support for Courier V.Everything
; Modified 2/5/98 Rob B - AE  and Bill K - NSD AE
; Modified 2/7/98 Rob B - AE > Corrected HST and Terbo responses, V23 enable command corrected
; Modified 3/13/98

[Version]
Signature="$CHICAGO$"
Class=Modem
Provider=%USR%
CLASSGUID={4D36E96D-E325-11CE-BFC1-08002BE10318}

[Manufacturer]
%USR% = USR

[ControlFlags]
ExcludeFromSelect=*USR0009 
ExcludeFromSelect=SERENUM\USR0100

[Modemex.NoResDup]
UNIMODEM9C2771B0, UNIMODEM34F771B2, UNIMODEM5859587C, UNIMODEMB5882579 

[Modemin.PosDup]
*PNP0500

[USR]
%Modem1%  = Modemex, SERENUM\USR0100  
%Modem2%  = Modemex, UNIMODEM9C2661B0  ; Bogus for "select from" problem

%Modem10% = Modemin, *USR0009         
%Modem11% = Modemin, UNIMODEM9C2771B0
%Modem12% = Modemin, UNIMODEM34F771B2
%Modem13% = Modemin, UNIMODEM5859587C
%Modem14% = Modemin, UNIMODEMB5882579

[Modemex]
AddReg=All, AddRegEx, Courier, External, Response, V23, V90_x2

[AddRegEx]
HKR,, Properties, 1, 80,01,00,00, FF,00,00,00, FF,00,00,00, 00,00,00,00, 0F,00,00,00, 77,07,00,00, 00,84,03,00, 00,FA,00,00 

[Modemin]
AddReg=All, AddRegIn, Courier, Internal, Response, V23, V90_x2

[AddRegIn]
HKR,, Properties, 1, 80,01,00,00, FF,00,00,00, FF,00,00,00, 07,00,00,00, 0F,00,00,00, 77,07,00,00, 00,C2,01,00, 00,FA,00,00

[External]
HKR,,DeviceType,1,01

[Internal]
HKR,,DeviceType,1,02
HKR, Settings,SpeakerVolume_High,,"L3"
HKR, Settings,SpeakerVolume_Low,,"L0"
HKR, Settings,SpeakerVolume_Med,,"L2"

[Strings]
USR     = "U.S. Robotics Access Corp."
Modem1  = "Courier V.Everything EXT PnP (V.90&x2)"
Modem2  = "Courier V.Everything EXT (V.90&x2)"

Modem10 = "Courier V.Everything INT PnP (V.90&x2)"
Modem11 = "Courier V.Everything INT (V.90&x2)"
Modem12 = "Courier V.Everything INT (V.90&x2)"
Modem13 = "Courier V.Everything INT (V.90&x2)"
Modem14 = "Courier V.Everything INT (V.90&x2)"

[All]
