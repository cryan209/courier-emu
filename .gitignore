# macOS and editor state
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Python caches, environments, and packaging output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
build/
dist/

# Native build products
.build/
*.o
*.obj
*.so
*.dylib
*.dll
*.exe

# ...but docs/usrdl/ holds vendor SDL upgrade packages, most of which are
# self-extracting ZIPs carrying the .exe suffix. They are source material, not
# build output.
!docs/usrdl/*.exe

# Emulator captures and diagnostic output.
# Primary evidence under artifacts/ is tracked: assembled ROM/RAM images,
# manifests, audits, page hashes and hardware transcripts. The per-page
# intermediates are not -- responses/ holds one raw serial reply per page and
# blocks/ holds the 256-byte pages that the assembled images are built from,
# together ~32 MB across ~8,200 files, all reconstructible from what is kept.
artifacts/**/responses/
artifacts/**/blocks/
# The Quad's flash and RAM dumps are the same case: probe_quad_identify.py and
# probe_quad_bringup rebuild every one of them from docs/x2/Qf060003.zip, which
# is tracked, and probe_quad_c50.py rebuilds the DSP stream from those. ~6 MB of
# images reconstructible from 363 KB of source, so the JSON and markdown results
# beside them are kept and the images are not.
artifacts/quad-identify-*/*.bin
artifacts/quad-bringup-*/*.bin
artifacts/quad-c50-*/stream.bin
*.s16le
*.pcm
*.wav
*.log
*.trace

# Local firmware inputs (not redistributable project source)
*.xmf
*.XMF
*.xmd
*.XMD
*.xmp
