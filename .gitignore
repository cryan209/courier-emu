# Native build products
.build/
*.o
*.obj
*.so
*.dylib
*.dll
*.exe

# Emulator captures and diagnostic output.
# Primary evidence under artifacts/ is tracked: assembled ROM/RAM images,
# manifests, audits, page hashes and hardware transcripts. The per-page
# intermediates are not -- responses/ holds one raw serial reply per page and
# blocks/ holds the 256-byte pages that the assembled images are built from,
# together ~32 MB across ~8,200 files, all reconstructible from what is kept.
artifacts/**/responses/
artifacts/**/blocks/
*.s16le
*.pcm
*.wav
*.log
*.trace

# Local firmware inputs (not redistributable project source)
*.xmf
*.XMF
*.xmd
*.XMD
*.xmp
*.XMP
*.nac
*.NAC
*.sdl
*.SDL
nvram.sav
