               USR-ATM-CROSS-CONNECT-MIB DEFINITIONS ::= BEGIN

               IMPORTS
                  OBJECT-TYPE
                      FROM SNMPv2-SMI
                  RowStatus
                      FROM SNMPv2-TC
                  DisplayString
                      FROM RFC1213-MIB
                  IfIndex
		      FROM ATM-MIB-ATMNET
		  usrAtmCrossConnect
		      FROM USR-DEFINITIONS-MIB
                  ;    

               --  The ATM VC Cross Connect for cli commands

               usrAtmVcCrossConnectTable OBJECT-TYPE
                    SYNTAX  SEQUENCE OF UsrAtmVcCrossConnectEntry
                    MAX-ACCESS  not-accessible
                    STATUS  current
                    DESCRIPTION
                     "This usrAtmVcCrossConnectTable keeps cross connect name
                      and corresponding cross connect index
                      pcr is used to obtain traffic descriptor Index."
                    ::= { usrAtmCrossConnect 1 }


               usrAtmVcCrossConnectEntry OBJECT-TYPE
                    SYNTAX  UsrAtmVcCrossConnectEntry
                    MAX-ACCESS  not-accessible
                    STATUS  current
                    DESCRIPTION " "
                    INDEX { usrAtmVcCrossConnectName}
                    ::= { usrAtmVcCrossConnectTable 1 }

               UsrAtmVcCrossConnectEntry ::= SEQUENCE {
                    usrAtmVcCrossConnectName           DisplayString,
                    usrAtmVcCrossConnectIndex          INTEGER,
                    usrAtmVcCrossConnectLowIfIndex     IfIndex,
                    usrAtmVcCrossConnectLowVpi         INTEGER,
                    usrAtmVcCrossConnectLowVci         INTEGER,
                    usrAtmVcCrossConnectHighIfIndex    IfIndex,
                    usrAtmVcCrossConnectHighVpi        INTEGER,
                    usrAtmVcCrossConnectHighVci        INTEGER,
                    usrAtmVcCrossConnectLowPort        INTEGER,
                    usrAtmVcCrossConnectHighPort       INTEGER,
                    usrAtmVcCrossConnectPcr            INTEGER,
                    usrAtmVcCrossConnectRowStatus      RowStatus
               }

               usrAtmVcCrossConnectName OBJECT-TYPE
                    SYNTAX  DisplayString
                    MAX-ACCESS  not-accessible
                    STATUS  current
                    DESCRIPTION "VC Cross connect name used as index"
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 1 }

               usrAtmVcCrossConnectIndex OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "cross connect index for the entry  "
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 2 }

               usrAtmVcCrossConnectLowIfIndex OBJECT-TYPE
                    SYNTAX  IfIndex
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "ifindex of the vc with low val "
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 3 }


               usrAtmVcCrossConnectLowVpi OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "vpi value of the vc with low ifindex"
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 4 }

               usrAtmVcCrossConnectLowVci OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "vci of the vc with low ifindex val"
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 5 }

               usrAtmVcCrossConnectHighIfIndex OBJECT-TYPE
                    SYNTAX  IfIndex
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "vc associated with high ifindex param"
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 6 }


               usrAtmVcCrossConnectHighVpi OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "vpi of the vc with high ifindex param"
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 7 }

               usrAtmVcCrossConnectHighVci OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "vci of the vc eith high ifindex val"
                    --CONFIGURABLE
                    ::= { usrAtmVcCrossConnectEntry 8 }

               usrAtmVcCrossConnectLowPort OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "low end port number"
                    ::= { usrAtmVcCrossConnectEntry 9 }

               usrAtmVcCrossConnectHighPort OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "high end port number"
                    ::= { usrAtmVcCrossConnectEntry 10 }

               usrAtmVcCrossConnectPcr OBJECT-TYPE
                    SYNTAX  INTEGER
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "peak cell rate -as traffic descr index created"
                    ::= { usrAtmVcCrossConnectEntry 11 }

               usrAtmVcCrossConnectRowStatus OBJECT-TYPE
                    SYNTAX  RowStatus
                    MAX-ACCESS   read-only
                    STATUS  current
                    DESCRIPTION  "cross connect row status"
                    ::= { usrAtmVcCrossConnectEntry 12 }
               END
--
--	usr_dsx3.mib - A MIB file for the Netserver gateway card
--                    Dsx3 MIB
--
--
-- Author:         Jay D. Miller
--
--
--  | Copyright (c) 1997 U.S. Robotics Access Corp., Skokie, IL 60076      |
--  |                                                                      |
--  | The information in this software is subject to change without notice |
--  | and should not be construed as a commitment by U.S. Robotics Access  |
--  | Corp.                                                                |
--  |                                                                      |
--  | U.S. Robotics Access Corp. assumes no responsibility for the use or  |
--  | reliability of its software on equipment which is not supplied by    |
--  | U.S. Robotics Access Corp.                                           |
--  |                                                                      |
--  | This software is furnished under a license and may be copied only    |
--  | with the inclusion of the above copyright notice. This software, or  |
--  | any other copies thereof, may not be provided or otherwise made      |
--  | available to any other person except to one who agrees to these      |
--  | license terms. Title to and ownership of the software shall at all   |
--  | times remain in U.S. Robotics Access Corp.                           |
--

USR-DSX3-MIB DEFINITIONS ::= BEGIN

	IMPORTS
        OBJECT-TYPE
            FROM SNMPv2-SMI
        DisplayString, usrDsx3, UsrConfigStatus
            FROM USR-DEFINITIONS-MIB;

	usrDsx3ConfigFileName OBJECT-TYPE
		SYNTAX      DisplayString
		MAX-ACCESS      read-write
		STATUS      current
		DESCRIPTION		
		  "The name of a ConfigFile to read/write permanent
		   database records. If the value of this object is an
                   empty string, then the NMBA process uses the
                   default name `@file://Dsx3.cfg'. "
	::= { usrDsx3 1 }

	usrDsx3CFMStatusFlag  OBJECT-TYPE
	 	SYNTAX	  UsrConfigStatus
		MAX-ACCESS      read-write
		STATUS      current
		DESCRIPTION
		  "Setting the value of this object to `save' causes the values
		   of the Dsx3SlotTable to be written out to the
                   current config file, which is stored in the 
                   usrDsx3ConfigFileName object. While the new
                   ConfigFile is being written, the NMBA process
		   will set the value of this flag to `saving''. Any
		   attempts to set the value while it is not `normal'
		   (i.e. the file is currently being written to the
		   ConfigFile) while result in a badValue error being
		   returned. Setting the value to `normal' will result in no
		   action."
	::= { usrDsx3 2 }

    usrDsx3ConfigTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF UsrDsx3ConfigEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
                "USR Specific variable Config table."
        ::= { usrDsx3 3 }

    usrDsx3ConfigEntry OBJECT-TYPE
        SYNTAX  UsrDsx3ConfigEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
                "An entry in the DSX3/E3 Configuration table."
        INDEX   { usrDsx3LineIndex }
        ::= { usrDsx3ConfigTable 1 }

    UsrDsx3ConfigEntry ::=
        SEQUENCE {
            usrDsx3LineIndex
                INTEGER,
            usrDsx3CableLength
                INTEGER,
            usrDsx3FrameType
                INTEGER,
            usrDsx3PayloadScrambling
                INTEGER,
            usrDsx3TransmitCells
                INTEGER,
            usrDsx3RecieveCells
                INTEGER
        }

    usrDsx3LineIndex OBJECT-TYPE
        SYNTAX  INTEGER (1..65535)
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
        "This object is the identifier of a DSX3/E3
        Interface on a managed device.  If there is an
        ifEntry that is directly associated with this
        and only this DSX3/E3 interface, it should have
        the same value as ifIndex.  Otherwise, number
        the dsx3LineIndices with an unique identifier
        following the rules of choosing a number that
        is greater than ifNumber and numbering the
        inside interfaces (e.g., equipment side) with
        even numbers and outside interfaces (e.g,
        network side) with odd numbers."
	::= { usrDsx3ConfigEntry 1 }

	usrDsx3CableLength  OBJECT-TYPE
		SYNTAX   INTEGER {
         usrDsx3ShortHaul(1),
         usrDsx3LongHaul(2)
			}
		MAX-ACCESS  read-write
		STATUS      current
		DESCRIPTION
                  "This variable indicates which compensation 
                  measures are to be used with varying cable
                  lengths.

                  usrDsx3ShortHaul refers to cable lengths
                  shorter than xx meters. atmDsx3LongHaul handles
                  cable lengths longer than that."

	        --CONFIGURABLE
	::= { usrDsx3ConfigEntry 2 }

	usrDsx3FrameType  OBJECT-TYPE
		SYNTAX   INTEGER {
         usrDsx3Adm(1),
         usrDsx3Plcp(2)
			}
		MAX-ACCESS  read-write
		STATUS      current
		DESCRIPTION
                "This variable indicates which frame type
                 to use in transmission.

                 usrDsx3Adm sets the Phy to use Direct Mapping
                 on transmit , and usrDsx3Plcp uses the PLCP
                 framing format."
                 
	        --CONFIGURABLE
	::= { usrDsx3ConfigEntry 3 }

	usrDsx3PayloadScrambling OBJECT-TYPE
		SYNTAX   INTEGER {
			enabled(1),
			disabled(2)
			}
      MAX-ACCESS      read-write
      STATUS      current
      DESCRIPTION
            "An indicator that tells if this interface is using
             Payload Scrambling.  Setting the variable to enabled
             sets the Phy interface allow scrambling."
	        --CONFIGURABLE
   ::= { usrDsx3ConfigEntry 4 }

    usrDsx3TransmitCells OBJECT-TYPE
        SYNTAX  INTEGER (1..65535)
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
        "This object contains the number of cells
        transmitted in the current valid interval. At
        the end of each interval the count is reset."
	::= { usrDsx3ConfigEntry 5 }

    usrDsx3RecieveCells OBJECT-TYPE
        SYNTAX  INTEGER (1..65535)
        MAX-ACCESS  read-only
        STATUS  current
        DESCRIPTION
        "This object contains the number of cells
        recieved in the current valid interval. At
        the end of each interval the count is reset."
	::= { usrDsx3ConfigEntry 6 }
END         -- End usrDsx3 MIB definitions







--
--	usr_atm_1483_pvc.mib - A MIB file for the Netserver ATM
--                             RFC1483 PVC MIB. 
--
--
-- Author:         Mike Redden
--
--
--  | Copyright (c) 1997 U.S. Robotics Access Corp., Skokie, IL 60076      |
--  |                                                                      |
--  | The information in this software is subject to change without notice |
--  | and should not be construed as a commitment by U.S. Robotics Access  |
--  | Corp.                                                                |
--  |                                                                      |
--  | U.S. Robotics Access Corp. assumes no responsibility for the use or  |
--  | reliability of its software on equipment which is not supplied by    |
--  | U.S. Robotics Access Corp.                                           |
--  |                                                                      |
--  | This software is furnished under a license and may be copied only    |
--  | with the inclusion of the above copyright notice. This software, or  |
--  | any other copies thereof, may not be provided or otherwise made      |
--  | available to any other person except to one who agrees to these      |
--  | license terms. Title to and ownership of the software shall at all   |
--  | times remain in U.S. Robotics Access Corp.                           |
--
  USR-ATM-1483-PVC-MIB DEFINITIONS ::= BEGIN

  IMPORTS
      OBJECT-TYPE, IpAddress
          FROM SNMPv2-SMI
      RowStatus
          FROM SNMPv2-TC
      usrAtm1483Pvc, UsrConfigStatus, DisplayString
          FROM USR-DEFINITIONS-MIB
      AtmVpIdentifier, AtmVcIdentifier
	  FROM ATM-TC-MIB
      ;

  usrAtm1483PvcConfigFileName OBJECT-TYPE
      SYNTAX      DisplayString
      MAX-ACCESS  read-write
      STATUS      current
      DESCRIPTION		
	 "The name of a ConfigFile to read/write permanent
	  database records. If the value of this object is an
          empty string, then ATM 1483 uses the default
          name `@file://Atm1483.cfg'. "
     ::= { usrAtm1483Pvc 1 }

  usrAtm1483PvcCFMStatusFlag  OBJECT-TYPE
      SYNTAX	  UsrConfigStatus
      MAX-ACCESS  read-write
      STATUS      current
      DESCRIPTION
	  "Setting the value of this object to `save' causes the values
	   of the ATM ARP MIB objects to be written out to the
           current config file, which is stored in the 
           usrIpoaArpConfigFileName object. While the new
           ConfigFile is being written, ATM ARP
	   will set the value of this flag to `saving''. Any
	   attempts to set the value while it is not `normal'
	   (i.e. the file is currently being written to the
	   ConfigFile) while result in a badValue error being
	   returned. Setting the value to `normal' will result in no
	   action."
     ::= { usrAtm1483Pvc 2 }
  --
  -- The ATM 1483 PVC Table
  --

  usrAtm1483PvcTable OBJECT-TYPE
      SYNTAX      SEQUENCE OF UsrAtm1483PvcEntry
      MAX-ACCESS  not-accessible
      STATUS      current
      DESCRIPTION
          "This usrAtm1483PvcTable keeps a set of PVCs and
           creates a corresponding entry in the appropriate
           protocol ARP cache or equivalent."
      ::= { usrAtm1483Pvc 3 }

  usrAtm1483PvcEntry OBJECT-TYPE
      SYNTAX      UsrAtm1483PvcEntry
      MAX-ACCESS  not-accessible
      STATUS      current
      DESCRIPTION
          "A PVC that this host has opened with another host for
          data transer of datagrams using the encapsulation
          specified in RFC1483. Additional information
          can be determined about the VC from RFC1695, the AToM MIB.

	  When an entry is added to this table, if the corresponding
          network protocol is IP, an entry is added to the 
          ipNetToMediaTable (ARP Cache) to allow the translation of 
          an IP address to the RFC1483 PVC created in this table, 
          and the PVC created in the RFC1695 AToM MIB."

      INDEX       { usrAtm1483PvcName
                  }
      ::= { usrAtm1483PvcTable 1 }


  UsrAtm1483PvcEntry ::= SEQUENCE {
      usrAtm1483PvcName                 DisplayString,
      usrAtm1483PvcVpi                  AtmVpIdentifier,
      usrAtm1483PvcVci                  AtmVcIdentifier,
      usrAtm1483PvcPort			INTEGER,
      usrAtm1483PvcPcr			INTEGER,
      usrAtm1483PvcNetworkName          DisplayString,
      usrAtm1483PvcNetworkAddr          IpAddress,
      usrAtm1483PvcProtocol             INTEGER,
      usrAtm1483PvcRowStatus            RowStatus }

  usrAtm1483PvcName OBJECT-TYPE
      SYNTAX DisplayString (SIZE(0..32))
      MAX-ACCESS  not-accessible
      STATUS      current
      DESCRIPTION
         "A string containing the name of the RFC1483 PVC."
      --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 1 }

  usrAtm1483PvcVpi OBJECT-TYPE
      SYNTAX      AtmVpIdentifier
      MAX-ACCESS  read-create
      STATUS      current
      DESCRIPTION
          "The VPI value for the RFC1483 PVC."
	 --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 2 }

  usrAtm1483PvcVci OBJECT-TYPE
      SYNTAX      AtmVcIdentifier
      MAX-ACCESS  read-create
      STATUS      current
      DESCRIPTION
          "The VCI value for the RFC1483 PVC."
	 --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 3 }


  usrAtm1483PvcPort OBJECT-TYPE
      SYNTAX INTEGER(1..2)
      MAX-ACCESS  read-create
      STATUS      current
      DESCRIPTION
         "The port number for the RFC1483 PVC."
      --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 4 }

  usrAtm1483PvcPcr OBJECT-TYPE
      SYNTAX INTEGER(1000..100000)
      MAX-ACCESS  read-create
      STATUS      current
      DESCRIPTION
         "The peak cell rate value to use when creating this PVC."
      --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 5 }

  usrAtm1483PvcNetworkName OBJECT-TYPE
      SYNTAX DisplayString (SIZE(0..32))
      MAX-ACCESS  read-create
      STATUS      current
      DESCRIPTION
         "A string containing the name of the network of this RFC1483 PVC."
      --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 6 }

  usrAtm1483PvcNetworkAddr OBJECT-TYPE
      SYNTAX IpAddress
      MAX-ACCESS  read-create
      STATUS      current
      DESCRIPTION
         "The network layer address of the end station that this
          RFC1483 PVC connects to.  This value is placed in the 
          ARP cache as a static entry so that the IP forwarder
          may map traffic destined for this network address to 
          this RFC1483 PVC."

      --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 7 }

  usrAtm1483PvcProtocol OBJECT-TYPE
      SYNTAX INTEGER {
		     ip(1),
		     ipx(2),
		     at(3)
		     }
      MAX-ACCESS  read-only
      STATUS      current
      DESCRIPTION
         "The Level 3 protocol running over this RFC1483 PVC."
      --CONFIGURABLE
      ::= { usrAtm1483PvcEntry 8 }

  usrAtm1483PvcRowStatus OBJECT-TYPE
      SYNTAX      RowStatus
      MAX-ACCESS  read-create
      STATUS      current
      DESCRIPTION
         "This object allows rows to be created and deleted in the
          usrAtm1483PvcTable. For a PVC on an IP network, an entry 
          in this table will have a corresponding ipNetToMediaEntry 
          to allow the translation of an IP address to this PVC. Setting 
          this object to destroy(6) removes the corresponding 
          ipNetToMediaTable entry, if any."

     REFERENCE
         "RFC 1903, 'Textual Conventions for version 2 of the Simple
         Network Management Protocol (SNMPv2).'"
	 --CONFIGURABLE
     ::= { usrAtm1483PvcEntry 9 }

  usrAtm1483PvcDefaultPcr OBJECT-TYPE
      SYNTAX INTEGER
      MAX-ACCESS  read-only
      STATUS      current
      DESCRIPTION
         "An integer containing the default peak cell rate to use
	  when establishing VCs.  This value is one tenth the speed
          of the physical interface expressed as a cell rate."
      ::= { usrAtm1483Pvc 4 }

  END



--
--	usr_atm_1577_pvc.mib - MIB defined for supporting CLI commands for
--                             1577 PVCs.
--
-- Author:         
--
--
--  | Copyright (c) 1997 U.S. Robotics Access Corp., Skokie, IL 60076      |
--  |                                                                      |
--  | The information in this software is subject to change without notice |
--  | and should not be construed as a commitment by U.S. Robotics Access  |
--  | Corp.                                                                |
--  |                                                                      |
--  | U.S. Robotics Access Corp. assumes no responsibility for the use or  |
--  | reliability of its software on equipment which is not supplied by    |
--  | U.S. Robotics Access Corp.                                           |
--  |                                                                      |
--  | This software is furnished under a license and may be copied only    |
--  | with the inclusion of the above copyright notice. This software, or  |
--  | any other copies thereof, may not be provided or otherwise made      |
--  | available to any other person except to one who agrees to these      |
--  | license terms. Title to and ownership of the software shall at all   |
--  | times remain in U.S. Robotics Access Corp.                           |
--

               USR-ATM-1577-PVC-MIB DEFINITIONS ::= BEGIN

               IMPORTS
                  OBJECT-TYPE
                      FROM SNMPv2-SMI
                  DisplayString
                      FROM RFC1213-MIB
		  RowStatus
	              FROM SNMPv2-TC
                  IfIndex
		      FROM ATM-MIB-ATMNET
	          usrAtm1577Pvc
	              FROM USR-DEFINITIONS-MIB
                  ;    

               --  The ATM 1577 PVCs for cli commands

               usrAtm1577PvcTable OBJECT-TYPE
                    SYNTAX  SEQUENCE OF UsrAtm1577PvcEntry
                    MAX-ACCESS  not-accessible
                    STATUS  current
                    DESCRIPTION
                     "This usrAtm1577PvcTable keeps PVC name
                      and corresponding index values for the
                      VCL table row. It also contains mib objects
   		      that may be used in retrieving values for
 	              display of 1577 PVCs."
                    ::= { usrAtm1577Pvc 1 }

               usrAtm1577PvcEntry OBJECT-TYPE
                    SYNTAX  UsrAtm1577PvcEntry
                    MAX-ACCESS  not-accessible
                    STATUS  current
                    DESCRIPTION "This is the name of the RFC1577 PVC."
                    INDEX { usrAtm1577PvcName}
                    ::= { usrAtm1577PvcTable 1 }

               UsrAtm1577PvcEntry ::= SEQUENCE {
                    usrAtm1577PvcName	        DisplayString,
                    usrAtm1577PvcIfIndex        IfIndex,
                    usrAtm1577PvcVpi		INTEGER,
		    usrAtm1577PvcVci		INTEGER,
		    usrAtm1577PvcNetworkName    DisplayString,
		    usrAtm1577PvcPort           INTEGER,
		    usrAtm1577PvcPcr            INTEGER,
	 	    usrAtm1577PvcRowStatus      RowStatus
               }

               usrAtm1577PvcName OBJECT-TYPE
                    SYNTAX  DisplayString
                    MAX-ACCESS  not-accessible
                    STATUS  current
                    DESCRIPTION "ATM 1577 PVC name used as an index"
                    ::= { usrAtm1577PvcEntry 1 }

               usrAtm1577PvcIfIndex OBJECT-TYPE
                    SYNTAX  IfIndex
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "IfIndex of the ATMNET interface for this entry"
		    --CONFIGURABLE
                    ::= { usrAtm1577PvcEntry 2 }

               usrAtm1577PvcVpi OBJECT-TYPE
                    SYNTAX  INTEGER (0..4095)
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "VPI value of this ATM 1577 PVC "
                    --CONFIGURABLE
                    ::= { usrAtm1577PvcEntry 3 }

               usrAtm1577PvcVci OBJECT-TYPE
                    SYNTAX  INTEGER (0..65535)
                    MAX-ACCESS  read-create
                    STATUS  current
                    DESCRIPTION  "VCI value of this ATM 1577 PVC "
                    --CONFIGURABLE
                    ::= { usrAtm1577PvcEntry 4 }

               usrAtm1577PvcPort OBJECT-TYPE
		    SYNTAX INTEGER(1..2)
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION
                    "The port number for the RFC1577 PVC."
                    ::= { usrAtm1577PvcEntry 5 }

               usrAtm1577PvcPcr OBJECT-TYPE
                    SYNTAX INTEGER(1000..100000)
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION
                    "The peak cell rate configured for this PVC."
                    ::= { usrAtm1577PvcEntry 6 }

               usrAtm1577PvcNetworkName OBJECT-TYPE
                    SYNTAX DisplayString (SIZE(0..32))
                    MAX-ACCESS  read-only
                    STATUS      current
                    DESCRIPTION
                    "A string containing the name of the network of this RFC1577 PVC."
                    ::= { usrAtm1577PvcEntry 7 }

               usrAtm1577PvcRowStatus OBJECT-TYPE
                    SYNTAX  RowStatus
                    MAX-ACCESS  read-only
                    STATUS  current
                    DESCRIPTION  "1577 PVC VCL row status"
                    ::= { usrAtm1577PvcEntry 8 }
               END






--
--	usr_atmcfg.mib - A MIB file for ATM configuration for the
--                   Netserver gateway card
--                   AtmCfg MIB
--
--
-- Author:         Mike Clarke
--
--
--  | Copyright (c) 1997 U.S. Robotics Access Corp., Skokie, IL 60076      |
--  |                                                                      |
--  | The information in this software is subject to change without notice |
--  | and should not be construed as a commitment by U.S. Robotics Access  |
--  | Corp.                                                                |
--  |                                                                      |
--  | U.S. Robotics Access Corp. assumes no responsibility for the use or  |
--  | reliability of its software on equipment which is not supplied by    |
--  | U.S. Robotics Access Corp.                                           |
--  |                                                                      |
--  | This software is furnished under a license and may be copied only    |
--  | with the inclusion of the above copyright notice. This software, or  |
--  | any other copies thereof, may not be provided or otherwise made      |
--  | available to any other person except to one who agrees to these      |
--  | license terms. Title to and ownership of the software shall at all   |
--  | times remain in U.S. Robotics Access Corp.                           |
--

USR-ATMCFG-MIB DEFINITIONS ::= BEGIN

	IMPORTS
        OBJECT-TYPE
            FROM SNMPv2-SMI
        DisplayString, usrAtmCfg
            FROM USR-DEFINITIONS-MIB;

    usrAtmCfgTable OBJECT-TYPE
        SYNTAX  SEQUENCE OF UsrAtmCfgEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "USR Specific ATM Config table."
    ::= { usrAtmCfg 1 }
    
    usrAtmCfgEntry OBJECT-TYPE
        SYNTAX     UsrAtmCfgEntry
        MAX-ACCESS not-accessible
        STATUS     current
        DESCRIPTION
            "An entry in the Atm Configuration table."
        INDEX   { usrAtmIfName }
    ::= { usrAtmCfgTable 1 }
    
    UsrAtmCfgEntry ::=
        SEQUENCE {
           usrAtmIfName         DisplayString,
           usrSigAdminStatus    INTEGER,
           usrSigOperStatus     INTEGER,
           usrIlmiAdminStatus   INTEGER,
           usrIlmiOperStatus    INTEGER
        }

    usrAtmIfName OBJECT-TYPE
        SYNTAX      DisplayString
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
        "This object is the identifier of a ATM (AAL)
        Interface on a managed device."
	::= { usrAtmCfgEntry 1 }

    usrSigAdminStatus OBJECT-TYPE
        SYNTAX  INTEGER {
            enable(1),
            disable(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The desired state of Signalling on a desired interface.
             The interface name, specified by usrAtmIfName represents
             the AAL interface to enable or disable signalling on. If
             the state is 'enable' then signalling messages will flow
             on the interface. If the state is changed to disable,
             then all signalling messages will stop on the interface."

    --CONFIGURABLE
	::= { usrAtmCfgEntry 2 }

    usrSigOperStatus OBJECT-TYPE
        SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual state of Signalling on a desired interface.
             This state should follow the state set by
             usrSigAdminStatus."
	::= { usrAtmCfgEntry 3 }

    usrIlmiAdminStatus OBJECT-TYPE
        SYNTAX  INTEGER {
            enable(1),
            disable(2)
        }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The desired state of ILMI on a desired interface.  The
             interface name, specified by usrAtmIfName represents the
             AAL interface to enable or disable ILMI on. If the state
             is 'enable' then ILMI messages will flow on the
             interface. If the state is changed to disable, then all
             ILMI messages will stop on the interface."

    --CONFIGURABLE
	::= { usrAtmCfgEntry 4 }

    usrIlmiOperStatus OBJECT-TYPE
        SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The actual state of ILMI on a desired interface.  This
             state should follow the state set by usrSigAdminStatus."
	::= { usrAtmCfgEntry 5 }

END         -- End usrAtmCfg MIB definitions







