	::= { uumFramedRouteEntry 5 }

	uumFramedRouteIpMetric	OBJECT-TYPE
	SYNTAX	INTEGER (1..16)
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION	
		"The framed routing ip metric for the user"
	--CONFIGURABLE
	::= { uumFramedRouteEntry 6 }

	usrUserManRadiusAcctSecret	OBJECT-TYPE
