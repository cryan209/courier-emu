	uumFramedRouteIpMask
		IpAddress,
	uumFramedRouteIpGateway
		IpAddress,
	uumFramedRouteIpMetric
		INTEGER
	}

	uumFramedRouteUserName	OBJECT-TYPE
	SYNTAX	UsrUserName
