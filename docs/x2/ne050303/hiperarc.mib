        STATUS  mandatory
        DESCRIPTION
        "This value states whether or not the accounting counters will be 
	reset at a configured interval."
        DEFVAL { 2 }      
        --CONFIGURABLE   
        ::= { usrUserManGroup 206 }

	usrAuthSyslogFrequency  OBJECT-TYPE
	SYNTAX	INTEGER { 
			one-hour(0),
			six-hours(1),
			twelve-hours(2),
			twentyfour-hours(3),
			five-days(4)
		} 
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
        "This object specifies the time interval after which the authentication
	counters will be reset to zero."
        DEFVAL { 2 }      
        --CONFIGURABLE   
        ::= { usrUserManGroup 207 }
	
	usrAcctSyslogFrequency  OBJECT-TYPE
	SYNTAX	INTEGER { 
			one-hour(0),
			six-hours(1),
			twelve-hours(2),
			twentyfour-hours(3),
			five-days(4)
		} 
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
        "This object specifies the time interval after which the accounting
	counters will be reset to zero."
        DEFVAL { 2 }      
        --CONFIGURABLE   
        ::= { usrUserManGroup 208 }

        usrUserManRadiusPrimaryPref     OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Primary Auth  Server preference value when using PREFERED
                 algorithm"     
        --CONFIGURABLE
        ::= { usrUserManGroup 209 }
        
        usrUserManRadiusSecondaryPref   OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Secondary Auth  Server preference value when using PREFERED
                 algorithm"     
        --CONFIGURABLE
        ::= { usrUserManGroup 210 }
        
        usrUserManRadiusTertiaryPref    OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Tertiary Auth  Server preference value when using PREFERED
                 algorithm"     
        --CONFIGURABLE
        ::= { usrUserManGroup 211 }
        
        usrUserManPerServerRetryCount   OBJECT-TYPE
        SYNTAX  INTEGER
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Per Server Retry Count when using PREFERED algorithm"  
        --CONFIGURABLE
        ::= { usrUserManGroup 212 }
        
        usrUserManPerAcctServerRetryCount       OBJECT-TYPE
        SYNTAX  INTEGER
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Per Server Retry Count for Acct Servers"       
        --CONFIGURABLE
        ::= { usrUserManGroup 213 }

        usrUserManRadiusAcctCDRState     OBJECT-TYPE
        SYNTAX  INTEGER {
                        enabled(1),
                        disabled(2)
                        }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Indicates whether to send Call Detail Record in ACCT Stop req." 
        --CONFIGURABLE
        ::= { usrUserManGroup 214 }

        usrUserManRadiusAcctAggregateRoundRobinCount     OBJECT-TYPE
        SYNTAX  INTEGER (0..2147483647)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The total number of times the servers are switched in the 
		primary and secondary server group"
        ::= { usrUserManGroup 215 }
 
        usrUserManRadiusAcctAggregatePacketDiscardCount  OBJECT-TYPE
        SYNTAX  INTEGER (0..2147483647)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The total number of packets discarded in the primary and 
		secondary server group"
        ::= { usrUserManGroup 216 }
 
        usrUserManRadiusAcctAverageQueuePercentFull    OBJECT-TYPE
        SYNTAX  INTEGER (0..100)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The average of percentage of the queue filled in the primary 
		and secondary server group"
        ::= { usrUserManGroup 217 }
 
        usrUserManRadiusAcctAggregateOutstandingPacketCount      OBJECT-TYPE
        SYNTAX  INTEGER (0..2147483647)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The total number of packets outstanding in the primary 
		and secondary server group"
        ::= { usrUserManGroup 218 }

    uumPrioratizeAuthServer     OBJECT-TYPE
        SYNTAX  INTEGER
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION   
        "In Round Robin Feature, Try the first auth server initially"
        --CONFIGURABLE
         ::= { usrUserManGroup 219 }
 
    usrResourceFreeForTunnelInitiator      OBJECT-TYPE
     	SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "For a tunneled call(l2tp/pptp) user get authenticated at both
                 call initiator and call terminator thus uses 2 resources. If
                 enabled resources at the initiator is freed immediatly after
                 authentication else only when user goes away."
                DEFVAL { enabled }
        --CONFIGURABLE
        ::= { usrUserManGroup 220 }

        usrRadiusNasPortStyle OBJECT-TYPE
        SYNTAX  INTEGER {
                standard(1),
                format-one(2)
                }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
				"Takes STANDARD or format_one(UUNET) style for attribute values"
        --CONFIGURABLE
        ::= { usrUserManGroup 234 }

	usrRebootIndicationStyle  OBJECT-TYPE
        SYNTAX  INTEGER {
		fall-through(1),
		preferred-server(2)
	} 
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
        "Whether reboot indiaction is sent in fall-through fashion or in 
		round-robin manner according to server preference. 
		Default is fall-through style"
        DEFVAL { 1 }      
        --CONFIGURABLE   
        ::= { usrUserManGroup 222 }

        usrUserManRadiusAcctPrimaryPref    OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Primary Acct  Server preference value"
        --CONFIGURABLE
        ::= { usrUserManGroup 223 }
        
		usrUserManRadiusAcctSecondaryPref    OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Secondary Acct  Server preference value"
        --CONFIGURABLE
        ::= { usrUserManGroup 224 }
		
		usrUserManRadiusAcctBackupPrimaryFirstPref    OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Acct  Server preference value"
        --CONFIGURABLE
        ::= { usrUserManGroup 225 }
		
		usrUserManRadiusAcctBackupPrimarySecondPref    OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Acct  Server preference value"
        --CONFIGURABLE
        ::= { usrUserManGroup 226 }
		
		usrUserManRadiusAcctBackupSecondaryFirstPref    OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Acct  Server preference value"
        --CONFIGURABLE
        ::= { usrUserManGroup 227 }
		
		usrUserManRadiusAcctBackupSecondarySecondPref    OBJECT-TYPE
        SYNTAX  INTEGER (1..3)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Acct  Server preference value"
        --CONFIGURABLE
        ::= { usrUserManGroup 228 }

	usrUserManAuthFailTrapsState  OBJECT-TYPE
         SYNTAX  INTEGER {
                enabled(1),
                disabled(2)
                }
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             "Whether the User Authentication Failure Trap is enabled or disabled."
         DEFVAL { enabled }
         --CONFIGURABLE
         ::= { usrUserManGroup 231 }

	usrRadiusDNISAuthNasPortStyle  OBJECT-TYPE
        SYNTAX  INTEGER (0..1) 
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
        "DNIS authentication nas port , default means fill the correct
		 value. null-value means, always send 0 for this attribute
		 during the dnis authentication request"
        DEFVAL { 1 }      
        --CONFIGURABLE   
        ::= { usrUserManGroup 237 }

	usrUserManReportedSpanDensity	OBJECT-TYPE
	SYNTAX	INTEGER (1..33)
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"Used when reporting RADIUS NAS-PORT attribute.
	         The reported NAS-PORT attribute for a call is
		 computed as: <slot#> * spanDensity[slot#] * usrUserManReportedSpanDensity +
                              <span#> *  usrUserManReportedSpanDensity +
		              <channel#> + usrUserManSlotSpanChanOffset
		 Default value is 24."
     	--CONFIGURABLE
	::= { usrUserManGroup 238 }

	usrUserManSlotNo OBJECT-TYPE
	SYNTAX	INTEGER (1..16)
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"The slot Number"
	--CONFIGURABLE
	::= { usrUserManGroup 239 }

	usrUserManNoOfSpans OBJECT-TYPE
	SYNTAX	OCTET STRING (SIZE (1..16))
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"The No of spans in a slot"
	--CONFIGURABLE
	::= { usrUserManGroup 240 }

	usrUserManSpanDensityStyle OBJECT-TYPE
	SYNTAX	INTEGER {
                global(1),
                spanbased(2)
                }
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"The span density style"
	--CONFIGURABLE
	::= { usrUserManGroup 241 }
    
	usrRadiusCFGAuthServiceType      OBJECT-TYPE
    SYNTAX  INTEGER
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
           "The service type set fot  authenticaton request.
			Default 0 means no value set."
    --CONFIGURABLE
    ::= { usrUserManGroup 242 }

    usrUserManEnhancedTunnelingAcct OBJECT-TYPE
    SYNTAX  TruthValue
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "If set to true(1), the new accounting status type packets for
         tunneled calls will be sent. if set to false(2), they will not
         be sent."
    DEFVAL { true }
    --CONFIGURABLE
    ::= { usrUserManGroup 243 }

     usrReturnCallRejectCode  OBJECT-TYPE
         SYNTAX INTEGER(0|1)   
        
         ACCESS  read-write      
         STATUS  mandatory     
         DESCRIPTION
             "If the value is 1 the HARC will return the call reject code to the DSP card, otherwise if it is zero it will disable the call reject code feature"
         --CONFIGURABLE
         ::= { usrUserManGroup 250 }	


	usrUserManAuthFailure TRAP-TYPE
        ENTERPRISE  usrUserManTraps
        VARIABLES   {    
                usrUserManRadiusIP,
                usrUserManRadiusAltIP,
                usrUserManRadiusTertiaryIP
        }
        DESCRIPTION     "This trap is generated when 
			authentication fails for a user."
        --#TYPE "Alarm"
        ::= 1

	usrUserManRadiusBusyoutTrap TRAP-TYPE  
        ENTERPRISE  usrUserManTraps
        VARIABLES   {     
                usrUserManRadiusIP,
                usrUserManRadiusAltIP,
                usrUserManRadiusTertiaryIP,
                usrUserManRadiusAcctIP,
                usrUserManRadiusAcctFirstBackupIP,
                usrUserManRadiusAcctSecondBackupIP,
                usrUserManRadiusAcctAltIP, 
                usrUserManRadiusAcctAltFirstBackupIP,
                usrUserManRadiusAcctAltSecondBackupIP
        }
        DESCRIPTION     "This trap is generated when none of the authentication or accounting
servers can be contacted from the NAS and we mark the ports busy."
        --#TYPE "Alarm"
        ::= 2 
END
