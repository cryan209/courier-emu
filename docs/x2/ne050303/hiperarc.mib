           usrCipModemCompressionStatisticsModemCompMnp5           Counter32,
		usrCipModemCompressionStatisticsResetTime  OCTET STRING
		}

	 usrCipModemCompressionStatisticsIndex OBJECT-TYPE
           SYNTAX     INTEGER
           ACCESS not-accessible
           STATUS     mandatory
           DESCRIPTION
                 "The index for the Modem Compression statistics display.
                  they are 0-now& 1-total."
           ::= { usrCipModemCompressionStatisticsEntry 1 }
	

	usrCipModemCompressionStatisticsModemCompNone OBJECT-TYPE
           SYNTAX     Counter32
           ACCESS read-only
           STATUS     mandatory
           DESCRIPTION
                 "The number of calls that has No Modem Compression."
           ::= { usrCipModemCompressionStatisticsEntry 2 }

	usrCipModemCompressionStatisticsModemCompV42Bis OBJECT-TYPE
           SYNTAX     Counter32
           ACCESS read-only
           STATUS     mandatory
           DESCRIPTION
                 "The number of calls that has V_42Bis modem compression."
           ::= { usrCipModemCompressionStatisticsEntry 3 }

	usrCipModemCompressionStatisticsModemCompMnp5 OBJECT-TYPE
           SYNTAX     Counter32
           ACCESS read-only
           STATUS     mandatory
           DESCRIPTION
                 "The number of calls that has mnp5 modem compression."
           ::= { usrCipModemCompressionStatisticsEntry 4 }

    usrCipModemCompressionStatisticsResetTime	OBJECT-TYPE
			SYNTAX	OCTET STRING (SIZE (12))
			ACCESS	read-write
			STATUS	mandatory
			DESCRIPTION
				"Time the Speed statistics counters were last reset to value zero."
    ::= { usrCipModemCompressionStatisticsEntry 5 }

	usrCipTelnetConnectionTimeout  OBJECT-TYPE
         SYNTAX  INTEGER
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             "For host rotation a configurable connection timeout"
     --CONFIGURABLE
         ::= { usrCip 71 }

    usrCipTelnetBuffering  OBJECT-TYPE
         SYNTAX  INTEGER
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             "For a login user, whether CIP to TELNET buffering           
             should be turned on or off flag"
     --CONFIGURABLE
         ::= { usrCip 72 }

-- ifdef VIRT_DYN
-- Modem Group Template Table
--
      usrCipModemGroupTemplateTable OBJECT-TYPE
         SYNTAX  SEQUENCE OF USRCIPModemGroupTemplateEntry 
         ACCESS  not-accessible
         STATUS  mandatory
         DESCRIPTION
            "This is the table of all modem group templates"
      ::= { usrCip 93 }

     usrCipModemGroupTemplateEntry OBJECT-TYPE
        SYNTAX      USRCIPModemGroupTemplateEntry
        ACCESS      not-accessible
        STATUS      mandatory
        DESCRIPTION "Each entry corresponds to a virtual dynamic modem group."
        INDEX   {
                usrCipModemGroupTemplateGroupName
               }
     ::= {usrCipModemGroupTemplateTable 1}

     USRCIPModemGroupTemplateEntry ::= 
          SEQUENCE {
                usrCipModemGroupTemplateGroupName
                   DisplayString,
--
-- The following are per-interface entries from the configurator 
--
		usrCipModemGroupTemplateCfgIfInFilter 
			DisplayString,
		usrCipModemGroupTemplateCfgIfOutFilter 
			DisplayString,
		usrCipModemGroupTemplateCfgIfFilterAccess 
			INTEGER,
		usrCipModemGroupTemplateCfgIfPolicy 
			DisplayString,
		usrCipModemGroupTemplateCfgIfPolicyAccess 
			INTEGER,
		usrCipModemGroupTemplateCfgIfType  
			INTEGER,
--
-- The following are per port parameters(SPP)
--
               usrCipModemGroupTemplatePortType
                    INTEGER,
               usrCipModemGroupTemplatePortAccess
                    INTEGER,
               usrCipModemGroupTemplatePortHostType
                    INTEGER,
               usrCipModemGroupTemplatePortLoginService
                    INTEGER,
               usrCipModemGroupTemplatePortTcpPortNumber
                    INTEGER,
               usrCipModemGroupTemplatePortLoginMsg
                    OCTET STRING,
               usrCipModemGroupTemplatePortLoginPrompt
                    OCTET STRING,
               usrCipModemGroupTemplatePortIpAddress
                    IpAddress,
               usrCipModemGroupTemplatePortHostIpAddress
                    IpAddress,
               usrCipModemGroupTemplatePortNetMask
                    INTEGER,
               usrCipModemGroupTemplatePortProtocol
                    INTEGER,
               usrCipModemGroupTemplatePortMtu
                    INTEGER,
               usrCipModemGroupTemplatePortIdleTimeOut
                    INTEGER,
               usrCipModemGroupTemplateInitScriptName
                    DisplayString,
               usrCipModemGroupTemplateIfConnType
                    INTEGER,
               usrCipModemGroupTemplatePromptUserName
                    OCTET STRING,
               usrCipModemGroupTemplateUserPasswd
                    OCTET STRING,
               usrCipModemGroupTemplateDialPrefix
                    OCTET STRING,
               usrCipModemGroupTemplatePortPromptingStyle
                    INTEGER,
               usrCipModemGroupTemplatePortLoginProcessing
                    INTEGER,
               usrCipModemGroupTemplatePortDNISAuthentication
                   INTEGER,
               usrCipModemGroupTemplatePortDNISAuthTime
                   INTEGER,
               usrCipModemGroupTemplatePortDNISAuthType 
                   INTEGER,
               usrCipModemGroupTemplatePortDNISPassword
                   OCTET STRING,
               usrCipModemGroupTemplatePortDNISTimeout
                   INTEGER,
               usrCipModemGroupTemplatePortParity
                    INTEGER,
               usrCipModemGroupTemplatePromptDelay
                   INTEGER,
               usrCipModemGroupTemplatePromptTimeout
                   INTEGER,
               usrCipModemGroupTemplateSpecialXonXoffFlow 
                   INTEGER,
               usrCipModemGroupTemplateUseDnisPool 
                    INTEGER,
               usrCipModemGroupTemplateLoginTable
                    OCTET STRING
               }

     usrCipModemGroupTemplateGroupName OBJECT-TYPE
          SYNTAX        DisplayString 
          ACCESS        not-accessible
          STATUS        mandatory
          DESCRIPTION   "The identifier of a modem group."
     ::= { usrCipModemGroupTemplateEntry 1 }

     
     usrCipModemGroupTemplateCfgIfInFilter OBJECT-TYPE
     	SYNTAX      DisplayString (SIZE(0..20))
     	ACCESS      read-write
     	STATUS      mandatory
     	DESCRIPTION "The name of the input filter for a specific interface."
           --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 2 }
     
     usrCipModemGroupTemplateCfgIfOutFilter OBJECT-TYPE
     	SYNTAX      DisplayString (SIZE(0..20))
     	ACCESS      read-write
     	STATUS      mandatory
     	DESCRIPTION "The name of the output filter for a specific interface."
            --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 3 }
     
     usrCipModemGroupTemplateCfgIfFilterAccess OBJECT-TYPE
            SYNTAX      INTEGER {
     	                        off (0),
                                  on (1)
                                }
            ACCESS      read-write
            STATUS      mandatory
            DESCRIPTION "This switch will allow user filters to override the
                         interface filters. If set to 'off', user filters do not
     				override the interface filters. If set to 'on' user
     				filters can override the interface filters."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 4 }
     
     usrCipModemGroupTemplateCfgIfPolicy OBJECT-TYPE
     	SYNTAX      DisplayString (SIZE(0..20))
     	ACCESS      read-write
     	STATUS      mandatory
     	DESCRIPTION "The name of the  policy for a specific interface."
           --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 5 }
     
     usrCipModemGroupTemplateCfgIfPolicyAccess OBJECT-TYPE
            SYNTAX      INTEGER {
     	                        off (0),
                                  on (1)
                                }
            ACCESS      read-write
            STATUS      mandatory
            DESCRIPTION "This switch will allow user policy to override the
                         interface policy. If set to 'off', user policies do not
     				override the interface policy. If set to 'on' user
     				policy can override the interface policy."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 6 }
     
     usrCipModemGroupTemplateCfgIfType OBJECT-TYPE  
         SYNTAX INTEGER
         ACCESS not-accessible
         STATUS mandatory    
         DESCRIPTION 
             "The type of interface, distinguished according to
             the physical/link protocol(s) immediately below
             the network layer in the protocol stack."
     ::= {  usrCipModemGroupTemplateEntry 7 } 

     usrCipModemGroupTemplatePortType OBJECT-TYPE
          SYNTAX      INTEGER {
                         login (1),
                         network (2),
                         login-network (3)
                         }
          ACCESS      read-write
          STATUS      mandatory
          DESCRIPTION "The type of the physical port."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 8}

     usrCipModemGroupTemplatePortAccess OBJECT-TYPE
          SYNTAX      INTEGER {
                         dial-in(1),
                         dial-out(2),
                         two-way(3)
                       }
          ACCESS      read-write
          STATUS      mandatory
          DESCRIPTION "This field specifies the direction of the calls
                         that could be made on a specific interface. 
                         Ports could be configured to be dial-in, dial-out
                         or two-way ports."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 9}

     usrCipModemGroupTemplatePortHostType OBJECT-TYPE
          SYNTAX      INTEGER {
                         default (1),
                         prompt (2),
                         specified (3)
                         }
          ACCESS      read-write
          STATUS      mandatory
          DESCRIPTION "The host type that the dial-in user 
                       will be connected to."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 10}

     usrCipModemGroupTemplatePortLoginService OBJECT-TYPE
          SYNTAX      INTEGER {
                         telnet (1),
                         rlogin (2),
                         netdata (3)
                         }
          ACCESS      read-write 
          STATUS      mandatory
          DESCRIPTION "The Service type that the dial-in user will 
                       be connected to."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 11}

     usrCipModemGroupTemplatePortTcpPortNumber OBJECT-TYPE
          SYNTAX      INTEGER
          ACCESS      read-write
          STATUS      mandatory
          DESCRIPTION "The tcp port number associated with the service type."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 12}

     usrCipModemGroupTemplatePortLoginMsg OBJECT-TYPE
          SYNTAX      OCTET STRING (SIZE(0..255))
          ACCESS      read-write
          STATUS      mandatory
          DESCRIPTION "The salutation message associated with a specific port."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 13}

     usrCipModemGroupTemplatePortLoginPrompt OBJECT-TYPE
   	  SYNTAX      OCTET STRING (SIZE(0..64))
   	  ACCESS      read-write
   	  STATUS      mandatory
   	  DESCRIPTION "The login prompt associated with a specific port."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 14}

     usrCipModemGroupTemplatePortIpAddress OBJECT-TYPE
   	  SYNTAX      IpAddress
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "The IP address for a specific serial port."
            --CONFIGURABLE
      ::= { usrCipModemGroupTemplateEntry 15}

     usrCipModemGroupTemplatePortHostIpAddress OBJECT-TYPE
   	  SYNTAX      IpAddress
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "A host IP address specified for this interface."
            --CONFIGURABLE
   	::= { usrCipModemGroupTemplateEntry 16}

     usrCipModemGroupTemplatePortNetMask OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
   	  DESCRIPTION "The netmask associated with a specific 
                       serial interface."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 17}

     usrCipModemGroupTemplatePortProtocol OBJECT-TYPE
   	  SYNTAX      INTEGER {
                         ppp (1),
                         slip (2),
                         arap (3)
                    	   }
   	  ACCESS      read-write
   	  STATUS      mandatory
   	  DESCRIPTION "The protocol type configured for a specific interface."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 18}

     usrCipModemGroupTemplatePortMtu OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
   	  DESCRIPTION "The mtu value associated with a specific interface."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 19}

     usrCipModemGroupTemplatePortIdleTimeOut OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
   	  DESCRIPTION "The maximum idle time specified for an interface."
            --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 20}

     usrCipModemGroupTemplateInitScriptName OBJECT-TYPE
          SYNTAX      DisplayString  (SIZE(0..7))
          ACCESS      read-write
          STATUS      mandatory
          DESCRIPTION "The name of the script"
            --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 21 }

     usrCipModemGroupTemplateIfConnType OBJECT-TYPE
          SYNTAX      INTEGER {
                        if-direct-conn (1),
                        if-direct-network-conn (2),
                        if-normal-conn (3),
                        if-prompt-passwd (4),
                        if-prompt-none (5),
						if-ppp-only(6)
                        }
          ACCESS      read-write
          STATUS      mandatory
          DESCRIPTION "The type of the connection that i/f is configured for."
            --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 22 }

     usrCipModemGroupTemplatePromptUserName OBJECT-TYPE
          SYNTAX        OCTET STRING (SIZE(0..32))
          ACCESS        read-write
          STATUS        mandatory
          DESCRIPTION   "This could only be set if the port is
                        configured not to prompt for username."
            --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 23 }

     usrCipModemGroupTemplateUserPasswd OBJECT-TYPE
          SYNTAX      OCTET STRING (SIZE(0..15))
   	  ACCESS      read-write
   	  STATUS      mandatory
   	  DESCRIPTION "This could only be set if the port is 
                       configured to not prompt for password."
            --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 24 }

     usrCipModemGroupTemplateDialPrefix OBJECT-TYPE
         SYNTAX         OCTET STRING (SIZE(0..64))
         ACCESS         read-write
         STATUS         mandatory
         DESCRIPTION    "This string defines the prefix to the phone number."
            --CONFIGURABLE
    ::= {  usrCipModemGroupTemplateEntry 25 }

    usrCipModemGroupTemplatePortPromptingStyle OBJECT-TYPE
         SYNTAX        INTEGER {
                           local-prompting(1),
                           remote-prompting(2)
                       }
         ACCESS        read-write
         STATUS        mandatory
         DESCRIPTION   "This value specifies whether the NAS will provide
                       username and password prompting locally or if the
                       prompting will be handled by a remote security server."
        --CONFIGURABLE
    ::= {  usrCipModemGroupTemplateEntry 26 }

    usrCipModemGroupTemplatePortLoginProcessing OBJECT-TYPE
        SYNTAX INTEGER {
                       enable (1),
                       disable (2)
                       }
        ACCESS read-write
        STATUS mandatory
        DESCRIPTION
            "This variable controls login processing.  Setting the value to disable
             will cause the box to not prompt a user for login name or password.  Enabling
             this value will cause the box to perform normal login name and password prompting."
        --CONFIGURABLE
        ::= { usrCipModemGroupTemplateEntry 27}
    

    usrCipModemGroupTemplatePortDNISAuthentication  OBJECT-TYPE
         SYNTAX INTEGER    
         {     
             dnis-auth-disabled (1),
             dnis-auth-preferred (2), 
             dnis-auth-required (3)
         }      
         ACCESS  read-write
         STATUS  mandatory       
         DESCRIPTION  
             "DNIS Authentication type"
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 28 }

    usrCipModemGroupTemplatePortDNISAuthTime  OBJECT-TYPE
         SYNTAX INTEGER
         {
             before-answer (1),
             after-answer (2)
         }
         ACCESS read-write
         STATUS  mandatory
         DESCRIPTION
             "DNIS Authentication Time"
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 29 }
 
    usrCipModemGroupTemplatePortDNISAuthType  OBJECT-TYPE
         SYNTAX INTEGER
         {
             dnis (1),
             ani (2)
         }
         ACCESS read-write
         STATUS  mandatory
         DESCRIPTION
             "DNIS Authentication type"
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 30 }


     usrCipModemGroupTemplatePortDNISPassword OBJECT-TYPE
          SYNTAX      OCTET STRING (SIZE(0..15))
   	  ACCESS    read-write
   	  STATUS      mandatory
   	  DESCRIPTION "The DNIS  password."
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 31 }


     usrCipModemGroupTemplatePortDNISTimeout OBJECT-TYPE
          SYNTAX      INTEGER
          ACCESS      read-write  
          STATUS      mandatory
          DESCRIPTION "Timeout if no auth within this time"
         --CONFIGURABLE
     ::= { usrCipModemGroupTemplateEntry 32}

    usrCipModemGroupTemplatePortParity  OBJECT-TYPE
         SYNTAX INTEGER       
         {      
			no-parity-eight-bit (1),
			even-seven-bit (2),  
			odd-seven-bit (3),  
			no-parity-seven-bit (4)
         }
         ACCESS  read-write 
         STATUS  mandatory
         DESCRIPTION
             "Port Parity"
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 33 }

    usrCipModemGroupTemplatePromptDelay  OBJECT-TYPE
         SYNTAX INTEGER (0..100)
         ACCESS   read-write
         STATUS  mandatory
         DESCRIPTION
             "If user does not enter any key after banner mesg, authenticate
              user based on interface user name after this delay"
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 34 }


    usrCipModemGroupTemplatePromptTimeout  OBJECT-TYPE
         SYNTAX INTEGER (5..600)
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             " This is the maximum timeout while prompting for 
				username password. If nothing is typed, the session will
				be terminated. Default is 300 secs"
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 35 }


      usrCipModemGroupTemplateSpecialXonXoffFlow  OBJECT-TYPE
         SYNTAX INTEGER       
         {      
             disbaled (0),
             enabled (1)
         }
         ACCESS read-write
         STATUS  mandatory
         DESCRIPTION
             "Specail Xon Xoff flow control in modem control receive side"
         --CONFIGURABLE
         ::= {  usrCipModemGroupTemplateEntry 36 }

	 usrCipModemGroupTemplateUseDnisPool OBJECT-TYPE
         SYNTAX INTEGER 
		 {
             dnis-pool-disabled (1),
             dnis-pool-preferred (2),
             dnis-pool-required (3)
         }
         ACCESS read-write
         STATUS  mandatory
         DESCRIPTION
             "User DNIS pool"
         --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 37 }

	 usrCipModemGroupTemplateLoginTable OBJECT-TYPE
         SYNTAX OCTET STRING
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             "Login Host Table "
         --CONFIGURABLE
     ::= {  usrCipModemGroupTemplateEntry 38 }

-- Scalar Flag
    usrCipCfmModemGroupTemplateFlag OBJECT-TYPE
        SYNTAX          INTEGER
        ACCESS          read-write
        STATUS          mandatory
        DESCRIPTION    "This flag triggers a save of 
                         modem group template table."
    ::= { usrCip 94 } --Conflict CHAITANYA has to be resolved

--
-- endif VIRT_DYN
--

	usrCipOndemandConnectionRetries  OBJECT-TYPE
         SYNTAX  INTEGER(1..500)
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             ""
     --CONFIGURABLE
         ::= { usrCip 74 }

	usrCipOndemandConnectionRetryInterval  OBJECT-TYPE
         SYNTAX  INTEGER(1..600)
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             ""
     --CONFIGURABLE
         ::= { usrCip 75 }


END         -- End CIP-MIB definitions


