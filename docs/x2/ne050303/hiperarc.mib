	uumActiveSessionIdleTime	OBJECT-TYPE
	SYNTAX  INTEGER	
	ACCESS	read-only
	STATUS	mandatory
	DESCRIPTION
		"Session Idle Time"
	::= { uumActiveSessionEntry 9 }

