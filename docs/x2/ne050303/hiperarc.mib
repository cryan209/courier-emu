-- User managers framed route table definition

	usrUserManFramedRouteTable	OBJECT-TYPE
	SYNTAX	SEQUENCE OF UumFramedRouteEntry
	ACCESS	not-accessible
	STATUS	mandatory
	DESCRIPTION
		""
	--CONFIGURABLE
