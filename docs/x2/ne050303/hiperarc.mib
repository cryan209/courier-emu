Usr-Dhcp-MIB DEFINITIONS ::= BEGIN

        IMPORTS
          RowStatus
                FROM SNMPv2-TC
          Counter, IpAddress
                  FROM RFC1155-SMI
          OBJECT-TYPE
                  FROM RFC-1212
          DisplayString, usrDhcp, UsrConfigStatus
                  FROM USR-DEFINITIONS-MIB;


   -- textual conventions

          -- All representations of MAC addresses in this MIB Module
          -- use, as a textual convention (i.e. this convention does
          -- not affect their encoding), the data type:
    
          MacAddress ::= OCTET STRING (SIZE (6))    -- a 6 octet address
                                                    -- in the
                                                    -- "canonical"
                                                    -- order
          -- defined by IEEE 802.1a, i.e., as if it were transmitted
          -- least significant bit first, even though 802.5 (in
          -- contrast to other n802.x protocols) requires MAC
          -- addresses to be transmitted most significant bit first.


   -- Begin managed object definitions here...


     usrDhcpConfigFileName OBJECT-TYPE
         SYNTAX      DisplayString
         ACCESS      read-write
         STATUS      mandatory
         DESCRIPTION             
            "The name of a ConfigFile to read/write permanent database
             records.  If the value of this object is an empty string, 
             then the Filter Manager process uses the default name 
             `@file://filter.cfg'. "
     ::= { usrDhcp 1 }

     usrDhcpCFMStatusFlag  OBJECT-TYPE
         SYNTAX      UsrConfigStatus
         ACCESS      read-write
         STATUS      mandatory
         DESCRIPTION
            "Setting the value of this object to `save' causes the values
             of the SNMP Group to be written out to the current config
             file, which is stored in the usrFilterConfigFileName object.
             While the new ConfigFile is being written, the SNMP process
             will set the value of this flag to `saving''. Any
             attempts to set the value while it is not `normal'
             (i.e. the file is currently being written to the
             ConfigFile) will result in a badValue error being
             returned. Setting the value to `normal' will result in no
             action."
     ::= { usrDhcp 2 }

     usrDhcpAgent OBJECT-TYPE
         SYNTAX  INTEGER {
             disable(0),
             enable(1)
         }
         ACCESS read-write
         STATUS mandatory
         DESCRIPTION
             "this variable enables/disables the DHCP Relay Agent"
         --CONFIGURABLE
     ::= { usrDhcp 3 }
      
     usrDhcpServer1    OBJECT-TYPE
         SYNTAX  IpAddress
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             "when usrDhcpAgent is enabled, this variable contains the DHCP
              Server IP Address."
          --CONFIGURABLE
     ::= { usrDhcp 4 }
     
     usrDhcpServer2    OBJECT-TYPE
         SYNTAX  IpAddress
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
             "when usrDhcpAgent is enabled, this variable contains the DHCP
              Server IP Address."
          --CONFIGURABLE
     ::= { usrDhcp 5 }

     usrDhcpClientMessages OBJECT-TYPE
         SYNTAX  Counter
         ACCESS  read-only
         STATUS  mandatory
         DESCRIPTION
                 "The total number of messages received on the LAN
                 interface from the Client."
     ::= { usrDhcp 6 }

     usrDhcpServerMessages OBJECT-TYPE
         SYNTAX  Counter
         ACCESS  read-only
         STATUS  mandatory
         DESCRIPTION
                 "The total number of messages received on the WAN 
                 interfaces from the Servers."
     ::= { usrDhcp 7 }

     usrDhcpClientErrors   OBJECT-TYPE
         SYNTAX  Counter
         ACCESS  read-only
         STATUS  mandatory
         DESCRIPTION
                 "The total number of messages received on the LAN 
                 interfaces from the Client which were discarded 
                 due to validation errors."
     ::= { usrDhcp 8 }

     usrDhcpServerErrors   OBJECT-TYPE
         SYNTAX  Counter
         ACCESS  read-only
         STATUS  mandatory
         DESCRIPTION
                 "The total number of messages received on the WAN 
                 interfaces from the Servers which were discarded 
                 due to validation errors."
     ::= { usrDhcp 9 }

     usrDhcpCmGiAddr   OBJECT-TYPE
         SYNTAX  DisplayString
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
            "The network name for the Cable Modems in the Cable Modem Termination
			System"
          --CONFIGURABLE
     ::= { usrDhcp 10 }

     usrDhcpCpeGiAddr   OBJECT-TYPE
         SYNTAX  DisplayString
         ACCESS  read-write
         STATUS  mandatory
         DESCRIPTION
            "The network name for the Customer Premises Equipment in the 
			Cable Modem Termination System"
          --CONFIGURABLE
     ::= { usrDhcp 11 }


     usrDhcpMode  OBJECT-TYPE
         SYNTAX  INTEGER {
             enabled(1),
             disabled(2)
         }
         ACCESS read-write
         STATUS deprecated
         DESCRIPTION
             "this variable selects the DHCP mode. When set to Server, the 
              router will be a local DHCP server and assign configured addresses 
              and parameters to the clients on the LAN.  When set to Relay, 
              the router will send the Client DHCP/BOOTP requests to the 
              configured remote Server(s).  "
         DEFVAL { 2 } 
         --CONFIGURABLE
     ::= { usrDhcp 12 }
     
    usrDhcpProTable OBJECT-TYPE
	SYNTAX SEQUENCE OF UsrDhcpProEntry
	ACCESS not-accessible
	STATUS deprecated
	DESCRIPTION "Table of Client configuration profiles"
	::= {usrDhcp 13 }

    usrDhcpProEntry OBJECT-TYPE
	SYNTAX UsrDhcpProEntry
	ACCESS not-accessible
	STATUS deprecated
	DESCRIPTION "Client configuration profile"
	INDEX {usrDhcpProIndex}
	::= {usrDhcpProTable 1}

    UsrDhcpProEntry ::=
	SEQUENCE {
           usrDhcpProIndex 	INTEGER,
           usrDhcpProLease 	INTEGER,
           usrDhcpProRtr   	IpAddress,
           usrDhcpProDNS1  	IpAddress,
           usrDhcpProDNS2  	IpAddress,
           usrDhcpProWINS1 	IpAddress,
           usrDhcpProWINS2 	IpAddress,
           usrDhcpProHost	DisplayString,
           usrDhcpProDomain	DisplayString,
	   usrDhcpProStatus	RowStatus
  	   }

    usrDhcpProIndex OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS not-accessible
	STATUS mandatory
	DESCRIPTION "Profile index"
	::= {usrDhcpProEntry 1}

    usrDhcpProLease OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "Address lease lifetime. Default of -1 indicates infinite lease"
	--CONFIGURABLE
	::= {usrDhcpProEntry 2}

    usrDhcpProRtr OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "IP Address of default router for client"
	--CONFIGURABLE
	::= {usrDhcpProEntry 3}

    usrDhcpProDNS1 OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "IP address of DNS server for client"
	--CONFIGURABLE
	::= {usrDhcpProEntry 4}

    usrDhcpProDNS2 OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "IP address of secondary DNS server"
	--CONFIGURABLE
	::= {usrDhcpProEntry 5}

    usrDhcpProWINS1 OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "IP address of primary WINS server"
	--CONFIGURABLE
	::= {usrDhcpProEntry 6}

    usrDhcpProWINS2 OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "IP address of secondary WINS Server"
	--CONFIGURABLE
	::= {usrDhcpProEntry 7}

    usrDhcpProHost OBJECT-TYPE
	SYNTAX DisplayString (SIZE (0..32))
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "Base host name. Each host name allocated will a a numeric suffix added"
	--CONFIGURABLE
	::= {usrDhcpProEntry 8}

    usrDhcpProDomain OBJECT-TYPE
	SYNTAX DisplayString (SIZE (0..64))
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "Domain name"
	--CONFIGURABLE
	::= {usrDhcpProEntry 9}

    usrDhcpProStatus OBJECT-TYPE
	SYNTAX RowStatus
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Status of the Profile Table row"
	::= {usrDhcpProEntry 10}


    ---
    ---  Automatic Address allocation table
    ---
    usrDhcpAutoTable OBJECT-TYPE
	SYNTAX SEQUENCE OF UsrDhcpAutoEntry
	ACCESS not-accessible
	STATUS mandatory
	DESCRIPTION "Table of IP address allocation entries"
	::= {usrDhcp 14 }

    usrDhcpAutoEntry OBJECT-TYPE
	SYNTAX UsrDhcpAutoEntry
	ACCESS not-accessible
	STATUS deprecated
	DESCRIPTION "Automatic IP address allocation entry"
	INDEX {usrDhcpAutoIndex}
	::={ usrDhcpAutoTable 1}

    UsrDhcpAutoEntry ::=
	SEQUENCE {
		usrDhcpAutoIndex	INTEGER,
		usrDhcpAutoSeed		IpAddress,
		usrDhcpAutoMask		IpAddress,
		usrDhcpAutoRange	IpAddress,
		usrDhcpAutoPro		INTEGER,
		usrDhcpAutoStatus	RowStatus
	  }

    usrDhcpAutoIndex OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS not-accessible
	STATUS deprecated
	DESCRIPTION "Auto range index"
	::={ usrDhcpAutoEntry 1}

    usrDhcpAutoSeed OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "Initial seed address. Default 10.0.0.1"
	--CONFIGURABLE
	::= {usrDhcpAutoEntry 2}

    usrDhcpAutoMask OBJECT-TYPE	
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "Subnet mask. Default 255.0.0.0"
	--CONFIGURABLE
	::= {usrDhcpAutoEntry 3}

    usrDhcpAutoRange OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "Highest IP address. Default of 255.255.255.255 indicates up to limit of seed mask"
	--CONFIGURABLE
	::= {usrDhcpAutoEntry 4}

    usrDhcpAutoPro OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-write
	STATUS deprecated
	DESCRIPTION "Index of client configuration profile"
	::= {usrDhcpAutoEntry 5}

    usrDhcpAutoStatus OBJECT-TYPE
	SYNTAX RowStatus
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Status of the range table row"
	::= {usrDhcpAutoEntry 6}

    ---
    ---   Lease Status table
    ---   Displays details of allocated IP addresses and clients
    ---   to which they have been allocated
    ---
    usrDhcpLeaseTable OBJECT-TYPE
	SYNTAX SEQUENCE OF UsrDhcpLeaseEntry
	ACCESS not-accessible
	STATUS deprecated
	DESCRIPTION "A table of automatically allocated IP addresses"
	::= {usrDhcp 15 }

    usrDhcpLeaseEntry OBJECT-TYPE
	SYNTAX UsrDhcpLeaseEntry
	ACCESS not-accessible
	STATUS mandatory
	DESCRIPTION "A description of an automatically-allocated address"
	INDEX { usrDhcpLeaseIpAddr }
	::= {usrDhcpLeaseTable 1}

    UsrDhcpLeaseEntry ::=
	SEQUENCE {
           usrDhcpLeaseIpAddr  	IpAddress,
           usrDhcpLeaseIfIndex 	INTEGER,
           usrDhcpLeaseHwAddr  	MacAddress,
           usrDhcpLeaseCID     	OCTET STRING,
           usrDhcpLeaseValue	INTEGER,
           usrDhcpLeaseLife	INTEGER,
	   usrDhcpLeaseType	INTEGER,
	   usrDhcpLeaseStatus	RowStatus
         }

    usrDhcpLeaseIpAddr OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS not-accessible
	STATUS mandatory
	DESCRIPTION "Automatically allocated IP address"
	::= {usrDhcpLeaseEntry 1}

    usrDhcpLeaseIfIndex OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Interface over which IP address was allocated"
	::= {usrDhcpLeaseEntry 2}

    usrDhcpLeaseHwAddr OBJECT-TYPE
	SYNTAX MacAddress
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Hardware address of client to which IP address was allocated"
	::= {usrDhcpLeaseEntry 3}

    usrDhcpLeaseCID OBJECT-TYPE
	SYNTAX OCTET STRING
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Identifier of client to which IP address was allocated"
	::= {usrDhcpLeaseEntry 4}

    usrDhcpLeaseValue OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Lifetime of lease. -1 if permanently allocated"
	::= {usrDhcpLeaseEntry 5}

    usrDhcpLeaseLife OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Remaining lifetime of lease. -1 if permanently allocated"
	::= {usrDhcpLeaseEntry 6}

    usrDhcpLeaseType OBJECT-TYPE
	SYNTAX INTEGER {dynamic(1),manual(2)}
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Type of lease"
	::= {usrDhcpLeaseEntry 7}

    usrDhcpLeaseStatus OBJECT-TYPE
	SYNTAX RowStatus
	ACCESS read-write
	STATUS mandatory
	DESCRIPTION "Status of the Lease Table row"
	::= {usrDhcpLeaseEntry 8}

---
--- Server counters
---
   usrDhcpLeaseReqRx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 16 }

   usrDhcpRenewalReqRx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 17 }

   usrDhcpAcceptReqRx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 18 }
      
   usrDhcpDeclineRx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 19 }

   usrDhcpReleaseRx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 20}

   usrDhcpInvalidRx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 21}

   usrDhcpOfferTx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 22}

    usrDhcpConfirmTx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 23}

   usrDhcpDenialTx OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 24}

   usrDhcpReqAddrOutOfRange OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 25}

   usrDhcpReqAddrInUse OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 26}

   usrDhcpNoFreeAddr OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 27}

   usrDhcpReqLeaseTooLong OBJECT-TYPE
	SYNTAX Counter
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION ""
	::= {usrDhcp 28}

   usrDhcpProxyEnabled  OBJECT-TYPE
         SYNTAX  INTEGER {
             enabled(1),
             disabled(2)
         } 
         ACCESS read-write
         STATUS mandatory
         DESCRIPTION
             "this variable sets the DHCP proxy to enabled/disabled "
         --CONFIGURABLE
     ::= { usrDhcp 29 }

   usrDhcpProxyDiscIfLeaseExp  OBJECT-TYPE
         SYNTAX  INTEGER {
             yes(1),
             no(2)
         } 
         ACCESS read-write
         STATUS mandatory
         DESCRIPTION
             "this sets the behavior if IP address lease expires "
         --CONFIGURABLE
     ::= { usrDhcp 30 }

    ---
    ---   ProxyClient Lease Status table
    ---   Displays details of allocated IP addresses and clients
    ---   to which they have been allocated
    ---
    usrDhcpProxyLeaseTable OBJECT-TYPE
	SYNTAX SEQUENCE OF UsrDhcpProxyLeaseEntry
	ACCESS not-accessible
	STATUS mandatory
	DESCRIPTION "A table of automatically allocated IP addresses"
	::= {usrDhcp 31}

    usrDhcpProxyLeaseEntry OBJECT-TYPE
	SYNTAX UsrDhcpProxyLeaseEntry
	ACCESS not-accessible
	STATUS mandatory
	DESCRIPTION "A description of an automatically-allocated address"
	INDEX { usrDhcpProxyLeaseIndex }
	::= {usrDhcpProxyLeaseTable 1}

    UsrDhcpProxyLeaseEntry ::=
	SEQUENCE {
           usrDhcpProxyLeaseIndex   	INTEGER,
           usrDhcpProxyLeaseCID     	DisplayString,
           usrDhcpProxyLeaseIpAddr  	IpAddress,
           usrDhcpProxyLeaseIfIndex 	INTEGER,
           usrDhcpProxyLeaseHwAddr  	MacAddress,
           usrDhcpProxyLeaseValue	    INTEGER,
           usrDhcpProxyLeaseLife	    INTEGER
         }

    usrDhcpProxyLeaseIndex OBJECT-TYPE
    SYNTAX INTEGER
    ACCESS not-accessible
    STATUS mandatory
    DESCRIPTION "Index to the table which makes each entry unique"
    ::= {usrDhcpProxyLeaseEntry 1}

    usrDhcpProxyLeaseCID OBJECT-TYPE
	SYNTAX DisplayString
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION "Identifier of client to which IP address was allocated"
	::= {usrDhcpProxyLeaseEntry 2}

    usrDhcpProxyLeaseIpAddr OBJECT-TYPE
	SYNTAX IpAddress
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION "Automatically allocated IP address"
	::= {usrDhcpProxyLeaseEntry 3}

    usrDhcpProxyLeaseIfIndex OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION "Interface over which IP address was allocated"
	::= {usrDhcpProxyLeaseEntry 4}

    usrDhcpProxyLeaseHwAddr OBJECT-TYPE
	SYNTAX MacAddress
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION "Hardware address of client to which IP address was allocated"
	::= {usrDhcpProxyLeaseEntry 5}

    usrDhcpProxyLeaseValue OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION "Lifetime of lease. -1 if permanently allocated"
	::= {usrDhcpProxyLeaseEntry 6}

    usrDhcpProxyLeaseLife OBJECT-TYPE
	SYNTAX INTEGER
	ACCESS read-only
	STATUS mandatory
	DESCRIPTION "Remaining lifetime of lease. -1 if permanently allocated"
	::= {usrDhcpProxyLeaseEntry 7}

    usrDhcpProxyLeaseStatus OBJECT-TYPE
    SYNTAX RowStatus
    ACCESS read-only
    STATUS mandatory
    DESCRIPTION "Status of the Lease Table row"
    ::= {usrDhcpProxyLeaseEntry 8}

---
---  Proxy Client counters
---

     usrDhcpProxyDiscoveries OBJECT-TYPE
     SYNTAX Counter
     ACCESS read-only
	 STATUS mandatory
	 DESCRIPTION ""
	 ::= {usrDhcp 32 }

     usrDhcpProxyOffers OBJECT-TYPE
     SYNTAX Counter
     ACCESS read-only
	 STATUS mandatory
	 DESCRIPTION ""
	 ::= {usrDhcp 33 }

     usrDhcpProxyAddressesAcquired OBJECT-TYPE
     SYNTAX Counter
     ACCESS read-only
	 STATUS mandatory
	 DESCRIPTION ""
	 ::= {usrDhcp 34 }


     usrDhcpProxyAddressesReleased OBJECT-TYPE
     SYNTAX Counter
     ACCESS read-only
	 STATUS mandatory
	 DESCRIPTION ""
	 ::= {usrDhcp 35 }

     usrDhcpProxyClientsActive OBJECT-TYPE
     SYNTAX Counter
     ACCESS read-only
	 STATUS mandatory
	 DESCRIPTION ""
	 ::= {usrDhcp 36 }

     usrDhcpProxyT1renewals OBJECT-TYPE
     SYNTAX Counter
     ACCESS read-only
	 STATUS mandatory
	 DESCRIPTION ""
	 ::= {usrDhcp 37 }

     usrDhcpProxyT2renewals  OBJECT-TYPE
     SYNTAX Counter
     ACCESS read-only
	 STATUS mandatory
	 DESCRIPTION ""
	 ::= {usrDhcp 38 }

     usrDhcpProxyMaxRetry  OBJECT-TYPE
     SYNTAX INTEGER (2..5)
     ACCESS read-write
	 STATUS mandatory
	 DESCRIPTION "PRoxy Client retry count value"
	 DEFVAL { 2 }
	 --CONFIGURABLE
	 ::= {usrDhcp 39 }


    usrDhcpServerResetCounters	OBJECT-TYPE
    SYNTAX	INTEGER
    ACCESS	write-only
    STATUS	mandatory
    DESCRIPTION
    	"An user action to reset all the server counter contains to value zero"
    --CONFIGURABLE
    ::= { usrDhcp 40 }

    usrDhcpProxyClientResetCounters	OBJECT-TYPE
    SYNTAX	INTEGER
    ACCESS	write-only
    STATUS	mandatory
    DESCRIPTION
    	"An user action to reset all the ProxyClient counter contains to value zero"
    --CONFIGURABLE
    ::= { usrDhcp 41 }

    usrDhcpServerResetSettings	OBJECT-TYPE
    SYNTAX	INTEGER
    ACCESS	write-only
    STATUS	mandatory
    DESCRIPTION
    	"An user action to reset all the server Addresses to value zero"
    --CONFIGURABLE
    ::= { usrDhcp 42 }

END         -- End DHCP MIB definitions

--
-- For the revision history to work correctly, after a new MIB file has been
-- added to the CVS repository the first time the CVS Admin person needs to
-- set the correct comment string delimter for the file.
--
-- Revision 1.1  1996/03/18 21:01:40  freeve
-- First cut at filter MIB
--
--
--
USR-RSHD-MIB DEFINITIONS ::= BEGIN

    IMPORTS
        IpAddress
            FROM RFC1155-SMI
		Counter32 
			FROM  SNMPv2-SMI
        OBJECT-TYPE
            FROM RFC-1212
        usrRsh, UsrUserName
            FROM USR-DEFINITIONS-MIB;

	usrRshHostsTable OBJECT-TYPE
    SYNTAX  SEQUENCE OF USRRshHostsTableEntry
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION
        "Table of ip address and user name for connection authentication."
    ::= { usrRsh 1 }

    usrRshHostsTableEntry    OBJECT-TYPE
    SYNTAX  USRRshHostsTableEntry
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION
        "An entry of an ip address and user name for connection authentication."
    INDEX   { usrRshHostsTableIpAddress, usrRshHostsTableUserName}
    ::= { usrRshHostsTable 1 }

    USRRshHostsTableEntry ::= SEQUENCE {
         usrRshHostsTableUserName        UsrUserName,
         usrRshHostsTableIpAddress    IpAddress,
         usrRshHostsTableStatus      INTEGER
         }

    usrRshHostsTableUserName OBJECT-TYPE
    SYNTAX  UsrUserName
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION
        "The users name"
    ::= { usrRshHostsTableEntry 1 }

    usrRshHostsTableIpAddress OBJECT-TYPE
    SYNTAX  IpAddress
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION
        "The ip address of the remote hosts"
    ::= { usrRshHostsTableEntry 2 }

    usrRshHostsTableStatus   OBJECT-TYPE
    SYNTAX  INTEGER {
        delete(1),
        add(2)
        }
	ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "If set to 2 user name and the ip address is added to this pool. If
                 set to delet(1) this table is  deleted"
        --CONFIGURABLE
    ::= { usrRshHostsTableEntry 3 }

	usrRshTotalConnections OBJECT-TYPE
        SYNTAX Counter32
        ACCESS read-only
        STATUS mandatory
        DESCRIPTION
                "The total number of connections made"
        ::= { usrRsh 2 }

	 usrRshTotalRSHConnections OBJECT-TYPE
        SYNTAX Counter32
        ACCESS read-only
        STATUS mandatory
        DESCRIPTION
              "The total number of rsh requests"
        ::= { usrRsh 3 }

	 usrRshTotalRcpConnections OBJECT-TYPE
        SYNTAX Counter32
        ACCESS read-only
        STATUS mandatory
        DESCRIPTION
              "The total number of rcp requests"
        ::= { usrRsh 4 }

	 usrRshTotalAuthFailed OBJECT-TYPE
        SYNTAX Counter32
        ACCESS read-only
        STATUS mandatory
        DESCRIPTION
              "The total number of auth failed"
        ::= { usrRsh 5 }

	 usrRshTotalNASDropped OBJECT-TYPE
        SYNTAX Counter32
        ACCESS read-only
        STATUS mandatory
        DESCRIPTION
              "The total number of NAS dropped connections"
        ::= { usrRsh 6 }


END

   USR-VTP-MIB DEFINITIONS ::= BEGIN

   IMPORTS
           	Integer32, 
			Counter32, 
			OBJECT-TYPE 			FROM SNMPv2-SMI
           	IpAddress 				FROM RFC1155-SMI
			RowStatus,TimeStamp 	FROM SNMPv2-TC
			TRAP-TYPE				FROM RFC-1215

           	DisplayString,usrVTP,usrGre FROM USR-DEFINITIONS-MIB;

	-- Textual Conventions       
 
        IpxNetwork ::= OCTET STRING (SIZE(4))

	usrVtpControl		OBJECT IDENTIFIER ::= { usrVTP 1 }
	usrVtpStatistics	OBJECT IDENTIFIER ::= { usrVTP 2 }
	usrVtpCca			OBJECT IDENTIFIER ::= { usrVTP 3 }
	usrVtpCcaTunnel		OBJECT IDENTIFIER ::= { usrVtpCca 1 }
	usrVtpCcaSession	OBJECT IDENTIFIER ::= { usrVtpCca 2 }
	usrVtpTraps         OBJECT IDENTIFIER ::= { usrVTP 6 }

	 usrGreControl           OBJECT IDENTIFIER       ::= { usrGre 1 }
     usrGreStatistics        OBJECT IDENTIFIER       ::= { usrGre 2 }

	--
    --  VTP (Process & Protocol) Control Group
    --


	usrVtpTimecheck	OBJECT-TYPE
		SYNTAX		INTEGER { enabled(1),disabled(2) }
		MAX-ACCESS	read-write
		STATUS		current
		DESCRIPTION	
			"This variable allows enabling/disabling of the timestamp 
			 check performed by VTP on received messages. If there are 
			 problems with the NTP server and/or clock synchronization,
			 it should be set to disabled."
		--CONFIGURABLE
	::= { usrVtpControl 1 }

--
--	VTP Statistics Group
--

	usrVtpRegistrationRequestsIn   OBJECT-TYPE
       SYNTAX   Counter32
       MAX-ACCESS   read-only
       STATUS   current
       DESCRIPTION
        "A table containing all the counters."
       ::= { usrVtpStatistics 1 }
     
     usrVtpRegistrationRequestsOut  OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "Registration requests sent counter"
      ::= { usrVtpStatistics 2 }
     
     usrVtpRegistrationResponsesIn  OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "Registration responses recvd"
      ::= { usrVtpStatistics 3 }
     
     usrVtpRegistrationResponsesOut OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "Registration responses sent"
      ::= { usrVtpStatistics 4 }
     
     usrVtpRefreshRequestsIn    OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "Refresh requests received."
      ::= { usrVtpStatistics 5 }

     usrVtpRefreshRequestsOut   OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "Refresh requests sent"
      ::= { usrVtpStatistics 6 }
 
     usrVtpRefreshResponsesIn   OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "Refresh responses received."
      ::= { usrVtpStatistics 7 }
 
     usrVtpRefreshResponsesOut  OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "Refresh responses sent"
      ::= { usrVtpStatistics 8 }
 
     usrVtpDeregistrationRequestsIn OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "De registration requests received"
      ::= { usrVtpStatistics 9 }

     usrVtpDeregistrationRequestsOut OBJECT-TYPE
      SYNTAX    Counter32
      MAX-ACCESS    read-only
      STATUS    current
      DESCRIPTION
        "De registration requests received"
      ::= { usrVtpStatistics 10 }

	usrVtpDeregistrationResponsesIn   OBJECT-TYPE
          SYNTAX        Counter32
          MAX-ACCESS    read-only
          STATUS        current
          DESCRIPTION
                "De registration responses sent"
          ::= { usrVtpStatistics 11 }

	usrVtpDeregistrationResponsesOut   OBJECT-TYPE
          SYNTAX        Counter32
          MAX-ACCESS    read-only
          STATUS        current
          DESCRIPTION
                "De registration responses sent"
          ::= { usrVtpStatistics 12 }
 
     usrVtpPDUAuthenticationFailures    OBJECT-TYPE
          SYNTAX        Counter32
          MAX-ACCESS    read-only
          STATUS        current
          DESCRIPTION
                "PDU authentication failures"
          ::= { usrVtpStatistics 13 }
 
     usrVtpVPNValidationFailures    OBJECT-TYPE
          SYNTAX        Counter32
          MAX-ACCESS    read-only
          STATUS        current
          DESCRIPTION
                "VPN validation failures"
          ::= { usrVtpStatistics 14 }

	 usrVtpTimeCheckFailures OBJECT-TYPE
        SYNTAX      Counter32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The number of VTP messages which failed the
            timestamp check."
          ::= { usrVtpStatistics 15 }

--	
--	VTP CCA  Tunnel Group
--

	usrCcaTunnelTable OBJECT-TYPE
		SYNTAX		SEQUENCE OF UsrCcaTunnelEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"A table of CCA VTP tunnels"
	::= { usrVtpCcaTunnel 1 }

	usrCcaTunnelEntry 	OBJECT-TYPE
		SYNTAX		UsrCcaTunnelEntry
		MAX-ACCESS	not-accessible
		STATUS		current
		DESCRIPTION
			"An entry in the CCA VTP Tunnel table"
		INDEX { usrCcaTunnelTunnelIdx }
	::= { usrCcaTunnelTable 1 }

	UsrCcaTunnelEntry ::= SEQUENCE {
		usrCcaTunnelTunnelIdx			Integer32,
		usrCcaTunnelVPNName				DisplayString,
		usrCcaTunnelInterfaceName		DisplayString,
		usrCcaTunnelEstabTime			TimeStamp,
		usrCcaTunnelVPNId				Integer32,
		usrCcaTunnelGatewayAddr			IpAddress,
		usrCcaTunnelNasAddr				IpAddress,
		usrCcaTunnelSessionCount		Integer32,
		usrCcaTunnelStatus				RowStatus
	}

	usrCcaTunnelTunnelIdx	OBJECT-TYPE
		SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 1 }

	usrCcaTunnelVPNName OBJECT-TYPE
		SYNTAX		DisplayString
		MAX-ACCESS	read-only
		STATUS		current
		DESCRIPTION
			""
	::= { usrCcaTunnelEntry 2 }

	usrCcaTunnelInterfaceName 	OBJECT-TYPE
		SYNTAX		DisplayString
		MAX-ACCESS  read-only
		STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 3 }

	usrCcaTunnelEstabTime	OBJECT-TYPE
		SYNTAX      TimeStamp
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 4 }

	usrCcaTunnelVPNId	OBJECT-TYPE
		SYNTAX      Integer32      
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 5 }

	usrCcaTunnelGatewayAddr	OBJECT-TYPE
		SYNTAX      IpAddress      
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 6 }

	usrCcaTunnelNasAddr	OBJECT-TYPE
		SYNTAX      IpAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 7 }

	usrCcaTunnelSessionCount	OBJECT-TYPE
		SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 8 }

	usrCcaTunnelStatus	OBJECT-TYPE
		SYNTAX      RowStatus
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            ""
    ::= { usrCcaTunnelEntry 9 }

	--
    --  VTP CCA Session Group
    --
    
    usrCcaSessionTable OBJECT-TYPE
        SYNTAX SEQUENCE OF UsrCcaSessionEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION
            "A table of client sessions within a tunnel."
        ::= { usrVtpCcaSession 1 }
 
    usrCcaSessionEntry OBJECT-TYPE
        SYNTAX  UsrCcaSessionEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "An entry in the tunnel client session table."
        INDEX {usrCcaSessionTunnelId, usrCcaSessionSPI }
        ::= {usrCcaSessionTable 1 }
 
	UsrCcaSessionEntry ::= SEQUENCE {
        usrCcaSessionTunnelId       Integer32,
        usrCcaSessionSPI        Integer32,
        usrCcaSessionVPNId      Integer32,
        usrCcaSessionUserName       DisplayString,
        usrCcaSessionIPregistration INTEGER,
        usrCcaSessionIProuting      INTEGER,
        usrCcaSessionIProutingProto INTEGER,
        usrCcaSessionIPlocalAddress IpAddress,
        usrCcaSessionIPlocalMask    IpAddress,
        usrCcaSessionIPclientAddress    IpAddress,
        usrCcaSessionIPclientMask   IpAddress,
        usrCcaSessionIPXregistration    INTEGER,
        usrCcaSessionIPXrouting     INTEGER,
        usrCcaSessionIPXroutingProto    INTEGER,
        usrCcaSessionIPXlocalNetwork    IpxNetwork,
        usrCcaSessionIPXlocalNode   OCTET STRING,
        usrCcaSessionIPXclientNetwork   IpxNetwork,
        usrCcaSessionIPXclientNode  OCTET STRING,
        usrCcaSessionStatus     RowStatus
    }
    
    usrCcaSessionTunnelId OBJECT-TYPE
            SYNTAX      Integer32
            MAX-ACCESS      read-only
            STATUS          current
            DESCRIPTION
                        "The value used by VTP to uniquely identify this
                        tunnel by both the VPN Gateway and the NAS. This value
                        is also used in the GRE encapsulated packets to
                        identify which tunnel a given packet is on "
                ::= { usrCcaSessionEntry 1 }

	usrCcaSessionSPI OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The session's Security Parameter Index. Used to
            identify a given session."
        ::= { usrCcaSessionEntry 2 }
 
    usrCcaSessionVPNId OBJECT-TYPE
        SYNTAX      Integer32
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The VPN Identifier for the VPN that this session's
            tunnel is a member of "
        ::= { usrCcaSessionEntry 3 }
 
    usrCcaSessionUserName OBJECT-TYPE
        SYNTAX      DisplayString (SIZE(1..80))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The user login string as authenticated by the
            originating NAS."
        ::= { usrCcaSessionEntry 4 }
 
    usrCcaSessionIPregistration OBJECT-TYPE
        SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Indicates if IP is or is not registered for this
            session."
        ::= { usrCcaSessionEntry 5 }
 
	usrCcaSessionIProuting OBJECT-TYPE
        SYNTAX  INTEGER {
            none(0),
            broadcast(1),
            listen(2),
            broadcast-listen(3)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Indicates state of IP routing for this session."
        ::= { usrCcaSessionEntry 6 }
 
    usrCcaSessionIProutingProto OBJECT-TYPE
        SYNTAX  INTEGER {
            rip-I(1),
            rip-II(2),
            ospf(3)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "If IP routing is enabled, indicates which routing
            protocol is used for this session."
        ::= { usrCcaSessionEntry 7 }
 
    usrCcaSessionIPlocalAddress OBJECT-TYPE
        SYNTAX      IpAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IP address the VPN Gateway's virtual router is
            using for this link."
        ::= { usrCcaSessionEntry 8 }
 
	usrCcaSessionIPlocalMask OBJECT-TYPE
        SYNTAX      IpAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IP subnet mask the VPN Gateway's virtual router
            is using for this link."
        ::= { usrCcaSessionEntry 9 }
 
    usrCcaSessionIPclientAddress OBJECT-TYPE
        SYNTAX      IpAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IP address of the NAS's dial-in client, which is
            the remote end of this link."
        ::= { usrCcaSessionEntry 10 }
 
    usrCcaSessionIPclientMask OBJECT-TYPE
        SYNTAX      IpAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IP subnet mask of the NAS's dial-in client, which
            is the remote end of this link."
        ::= { usrCcaSessionEntry 11 }
 
    usrCcaSessionIPXregistration OBJECT-TYPE
        SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Indicates if IPX is or is not registered for this
            session "
        ::= { usrCcaSessionEntry 12 }
 
	usrCcaSessionIPXrouting OBJECT-TYPE
        SYNTAX  INTEGER {
            none(0),
            send(1),
            listen(2),
            respond(3),
            all(4)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "Indicates state of IPX routing for this session "
        ::= { usrCcaSessionEntry 13}
 
    usrCcaSessionIPXroutingProto OBJECT-TYPE
        SYNTAX  INTEGER {
            rip(1),
            nlsp(2)
        }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "If IPX routing is enabled, indicates which routing
            protocol is used for this session "
        ::= { usrCcaSessionEntry 14 }
 
    usrCcaSessionIPXlocalNetwork OBJECT-TYPE
        SYNTAX      IpxNetwork
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IPX Network number the VPN Gateway's virtual
            router is using for this link."
        ::= { usrCcaSessionEntry 15 }
 
	usrCcaSessionIPXlocalNode OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(6))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IPX Node address the VPN Gateway's virtual router
            is using for this link."
        ::= { usrCcaSessionEntry 16 }
 
    usrCcaSessionIPXclientNetwork OBJECT-TYPE
        SYNTAX      IpxNetwork
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IPX Network number of the NAS's dial-in client,
            which is the remote end of this link "
        ::= { usrCcaSessionEntry 17 }
 
    usrCcaSessionIPXclientNode OBJECT-TYPE
        SYNTAX      OCTET STRING (SIZE(6))
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION
            "The IPX Node address of the NAS's dial-in client,
            which is the remote end of this link "
        ::= { usrCcaSessionEntry 18 }
 
    usrCcaSessionStatus OBJECT-TYPE
        SYNTAX      RowStatus
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION
            "The status of this entry."
        ::= { usrCcaSessionEntry 19 }
 
	        --
        --      GRE Control Group
        --
    
        usrGreState OBJECT-TYPE
                SYNTAX  INTEGER {
                        enabled(1),
                        disabled(2)
                }
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Indicates if GRE is enabled or disabled. If the VTP
                        process is running, the state will always be enabled."
                ::= { usrGreControl 1 }
    
        --
        --      GRE Statistics Group
        --
    
        usrGreNetPktsIn OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of GRE encapsulated packets received from IP."
                ::= { usrGreStatistics 1 }
    
        usrGreNetPktsInDelivered OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of de-encapsulated GRE payloads delivered to
                        GRE clients."
                ::= { usrGreStatistics 2 }
    
		usrGreNetPktsInDiscarded OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Total count of de-encapsulated GRE payloads
                        discarded."
                ::= { usrGreStatistics 3 }
    
        usrGreNetPktsInHdrErrs OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of GRE packets discarded due to malformed
                        headers."
                ::= { usrGreStatistics 4 }
    
        usrGreNetPktsInNoClients OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of de-encapsulated GRE payloads discarded due
                        to no client."
                ::= { usrGreStatistics 5 }
    
        usrGreClientPktsIn OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of packets handed to GRE for encapsulation and
                        subsequent transmission."
                ::= { usrGreStatistics 6 }
    
		usrGreClientPktsEncapsulated OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of packets handed to GRE for encapsulation
                        which were actually encapsulated."
                ::= { usrGreStatistics 7 }
    
        usrGreClientPktsDiscarded OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of packets handed to GRE for encapsulation
                        which were discarded for some reason."
                ::= { usrGreStatistics 8 }
    
        usrGreClientPktToIP OBJECT-TYPE
                SYNTAX          Counter32
                MAX-ACCESS      read-only
                STATUS          current
                DESCRIPTION
                        "Count of GRE encapsulated payloads which were passed
                        to IP for transmission."
                ::= { usrGreStatistics 9 }
    
	usrVtpTunnelEstablishmentFailure TRAP-TYPE
        ENTERPRISE  usrVtpTraps
        VARIABLES   {
            usrCcaTunnelVPNId,
            usrCcaTunnelGatewayAddr
        }
        DESCRIPTION     "This trap is generated for tunnel
                        establishment failure."
    --#TYPE "Alarm" 
    ::= 1

	END
IPSEC-MIB DEFINITIONS ::= BEGIN

	IMPORTS
		Counter, IpAddress
			FROM RFC1155-SMI
		OBJECT-TYPE
			FROM RFC-1212
		TruthValue				FROM SNMPv2-TC
		usrIpSec, DisplayString
			FROM USR-DEFINITIONS-MIB;

	usrIpSecSAObjects	OBJECT IDENTIFIER ::= { usrIpSec  1}


-- User managers table definition

	usrSATable	OBJECT-TYPE
	SYNTAX SEQUENCE OF SaEntry
	ACCESS	not-accessible
	STATUS	mandatory
	DESCRIPTION
		""
	::= { usrIpSecSAObjects 1 }
 
	saEntry	OBJECT-TYPE
	SYNTAX	SaEntry
	ACCESS	not-accessible
	STATUS	mandatory
	DESCRIPTION
		""
	INDEX	{ usrSAIndex }
	::= { usrSATable 1 }

	SaEntry ::=
	SEQUENCE {
		usrSAIndex
			INTEGER,
		usrSASourceAddr
			IpAddress,
		usrSADestAddr
			IpAddress,
		usrSAStatus
			INTEGER
	}

	    usrSAIndex      OBJECT-TYPE
	    SYNTAX  INTEGER (0..2147483647)
	    ACCESS  read-only
	    STATUS  mandatory
	    DESCRIPTION
	           ""
	    ::= { saEntry 1 }

	    usrSASourceAddr      OBJECT-TYPE
	    SYNTAX  IpAddress
	    ACCESS  read-only
	    STATUS  mandatory
	    DESCRIPTION
	           ""
	    ::= { saEntry 2 }

	    usrSADestAddr      OBJECT-TYPE
	    SYNTAX  IpAddress
	    ACCESS  read-only
	    STATUS  mandatory
	    DESCRIPTION
	           ""
	    ::= { saEntry 3 }

	    usrSAStatus      OBJECT-TYPE
	    SYNTAX  INTEGER
	    ACCESS  read-only
	    STATUS  mandatory
	    DESCRIPTION
	           ""
	    ::= { saEntry 4 }
END
USR-SS7-MIB DEFINITIONS ::= BEGIN

    IMPORTS
        IpAddress
            FROM RFC1155-SMI
		Counter32 
			FROM  SNMPv2-SMI
        OBJECT-TYPE
            FROM RFC-1212
		DisplayString
			FROM SNMPv2-TC
		TRAP-TYPE
            FROM RFC-1215
        usrSS7
            FROM USR-DEFINITIONS-MIB;


usrSS7Protocol OBJECT-TYPE
    SYNTAX  INTEGER {
        slapv2(1),
        ipdc(2)
        }
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION " protocol being serviced:- HSS7I_SLAP_V2 or HSS7I_IPDC."
        --CONFIGURABLE
      ::= {usrSS7 1}

usrSS7LANStartMethod OBJECT-TYPE
   	  SYNTAX      INTEGER {
	  	auto(1),
		manual(2)
	   }
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "method to bring up TCP/IP connection to SS7GWP - HSS7I_LS_AUTO or HSS7I_LS_MANUAL."
        --CONFIGURABLE
      ::= {usrSS7 2}

usrSS7SLAPgatewayIPAddress OBJECT-TYPE
   	  SYNTAX      IpAddress
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "The IP address of the SLAP SS7 gateway."
        --CONFIGURABLE
      ::= {usrSS7 3}

usrSS7SLAPgatewayPort OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "The TCP port# of the SLAP SS7 gateway."
        --CONFIGURABLE
      ::= {usrSS7 4}

usrSS7SLAPHeartbeatTimerNearEnd OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "The heartbeat timer settings."
        --CONFIGURABLE
      ::= {usrSS7 5}

usrSS7SLAPChassisID OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "uniquely identify the TCH in a WAN. This is an unsigned Integer32" 
        --CONFIGURABLE
      ::= {usrSS7 6}

usrSS7SLAPNumberOfConnectionRetries OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "number of socket connection retries after lost it"
        --CONFIGURABLE
      ::= {usrSS7 7}

usrSS7SLAPConnectionRetryInterval OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "socket connection retry interval after it is lost"
        --CONFIGURABLE
      ::= {usrSS7 8}

usrSS7SLAPAllowedMissedHeartBeats OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "number of heartbeat missed from gw before action taken."
        --CONFIGURABLE
      ::= {usrSS7 9}

--  The following are the IPDC mibs which are not supported now..
--  remove the comments when they are supported..
-- 
-- usrSS7IPDCPrimaryIpAddress OBJECT-TYPE
--   	  SYNTAX      IpAddress
--   	  ACCESS      read-write
--   	  STATUS      mandatory
--	  DESCRIPTION " primary IP address to Soft Switch."
--        CONFIGURABLE
--      ::= {usrSS7 10}
--
-- usrSS7IPDCPrimaryPort OBJECT-TYPE
--   	  SYNTAX      INTEGER
--   	  ACCESS      read-write
--   	  STATUS      mandatory
--	  DESCRIPTION " primary port to Soft Switch."
--       CONFIGURABLE
--      ::= {usrSS7 11}
--
-- usrSS7IPDCSecondaryIpAddress OBJECT-TYPE
--    	  SYNTAX      IpAddress
--    	  ACCESS      read-write
--    	  STATUS      mandatory
-- 	  DESCRIPTION " Secondary IP address to Soft Switch."
--         CONFIGURABLE
--       ::= {usrSS7 12}
--
-- usrSS7IPDCSecondaryPort OBJECT-TYPE
--    	  SYNTAX      INTEGER
--    	  ACCESS      read-write
--    	  STATUS      mandatory
-- 	  DESCRIPTION " Secondary port to Soft Switch."
--         CONFIGURABLE
--       ::= {usrSS7 13}
--
-- usrSS7IPDCBayNumber OBJECT-TYPE
--    	  SYNTAX      INTEGER
--    	  ACCESS      read-write
--    	  STATUS      mandatory
-- 	  DESCRIPTION " Bay Number is an 8 bytes alphanumeric quantity which identifies the rack"
--       CONFIGURABLE
--      ::= {usrSS7 14}
--
-- usrSS7IPDCSystemType OBJECT-TYPE
-- 	  SYNTAX      INTEGER
-- 	  ACCESS      read-write
--  	  STATUS      mandatory
--	  DESCRIPTION "type of system by L3."
--       CONFIGURABLE
--      ::= {usrSS7 15}

usrSS7StatSBUSXmitPacketsOKCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of successful packets transmitted over the pBus connection."
      ::= {usrSS7 16}

usrSS7StatSBUSXmitPacketsFailCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of packets failed to transmit over the pBus connection."
      ::= {usrSS7 17}

usrSS7StatSBUSRcvdPacketsOKCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of successful packets received over the pBus connection."
      ::= {usrSS7 18}

usrSS7StatSBUSRcvdmitPacketsFailCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of packets rejected by the pBus/Sbus client application."
      ::= {usrSS7 19}

usrSS7StatGWXmitByetsCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of successful bytes transmitted over the SS7 GW connection."
      ::= {usrSS7 20}

usrSS7StatGWXmitPacketsCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of packets transmited to the SS7 GW connection."
      ::= {usrSS7 21}

usrSS7StatGWRcvdBytesCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of Bytes received over the SS7 GW connection."
      ::= {usrSS7 22}

usrSS7StatGWRcvdPacketsCount OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the number of packets from SS7 GW."
      ::= {usrSS7 23}

usrSS7GWConnectionState OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-only
   	  STATUS      mandatory
	  DESCRIPTION "the state of the SS7 GW connection UP/DOWN"
      ::= {usrSS7 24}

usrSS7SLAPSecondaryGatewayIPAddress OBJECT-TYPE
   	  SYNTAX      IpAddress
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "The IP address of the SLAP SS7 gateway."
        --CONFIGURABLE
      ::= {usrSS7 25}

usrSS7SLAPSecondaryGatewayPort OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "The TCP port# of the SLAP SS7 gateway."
        --CONFIGURABLE
      ::= {usrSS7 26}

usrSS7SLAPHeartbeatTimerFarEnd OBJECT-TYPE
   	  SYNTAX      INTEGER
   	  ACCESS      read-write
   	  STATUS      mandatory
	  DESCRIPTION "The heartbeat timer settings."
        --CONFIGURABLE
      ::= {usrSS7 27}

usrSS7SlotTable OBJECT-TYPE
        SYNTAX SEQUENCE OF UsrSS7SlotEntry
        ACCESS not-accessible
        STATUS mandatory
        DESCRIPTION
                  "A table containing one row per slot in the chassis.  Each
           row describes the characteristics of the slot"
    ::= { usrSS7 28 }

    usrSS7SlotEntry OBJECT-TYPE
         SYNTAX  UsrSS7SlotEntry
         ACCESS  not-accessible
         STATUS  mandatory
         DESCRIPTION
            "slot access table"
         INDEX   { usrSS7Slot }

    ::= { usrSS7SlotTable 1 }

    UsrSS7SlotEntry ::=
         SEQUENCE {
         usrSS7Slot
            INTEGER,
         usrSS7SlotOwner
            INTEGER,
         usrSS7SlotType
            INTEGER,
		 usrSS7SlotConnectionStatus
			INTEGER,
		 usrSS7SlotTrace
			INTEGER,
		 usrSS7SlotConnectToSlot
			INTEGER,
		 usrSS7SlotDisconnectToSlot
			INTEGER,
		 usrSS7ENFASLinkDownCause
			INTEGER
         }

	usrSS7Slot OBJECT-TYPE
         SYNTAX  INTEGER
	 ACCESS  not-accessible
         STATUS  mandatory
         DESCRIPTION
            "The slot number of this row."
	::= { usrSS7SlotEntry 1 }

	usrSS7SlotOwner OBJECT-TYPE
		SYNTAX   INTEGER {
			no(1),
			yes(2)
			}
         ACCESS   read-write
         STATUS   mandatory
         DESCRIPTION
            "An indication if this slot's card has this Gateway card assigned
             as the owning gateway"
        --CONFIGURABLE
    ::= { usrSS7SlotEntry 2 }

	usrSS7SlotType OBJECT-TYPE
		SYNTAX   INTEGER {
			static(1),
			dynamic(2)
			}
         ACCESS   read-write
         STATUS   mandatory
         DESCRIPTION
            "An indicator that tells if this slot's (row's) data was
             created statically by configuration, or dynamically by
             the receipt of chassis awareness information from the
             NMC.  Only static entries are saved to the configuration
             file.  Dynamic entries are saved as static entries with 
             an empty card type. If dynamic information is learned
             it replaces the information in a static entry.  A dynamic
             entry cannot be changed through the CLI or an SNMP set."
        --CONFIGURABLE
         ::= { usrSS7SlotEntry 3 }

	usrSS7SlotConnectionStatus OBJECT-TYPE
		 SYNTAX  INTEGER
         ACCESS  read-only
         STATUS  mandatory
         DESCRIPTION
            "The status of the sbus connection to HDM at this slot."
    ::= { usrSS7SlotEntry 4 }

   usrSS7SlotTrace    OBJECT-TYPE
			SYNTAX   INTEGER {
				enable(1),
				disable(0)
				}
			ACCESS  read-write
            STATUS  mandatory
            DESCRIPTION
                "SBUS Side SS7 Trace.  enable(1) disable(2) "
   ::= { usrSS7SlotEntry 5 }

   usrSS7SlotConnectToSlot    OBJECT-TYPE
			SYNTAX   INTEGER 
			ACCESS  read-write
            STATUS  mandatory
            DESCRIPTION
                "The Command to connect Hiper Arc to a SS7 channel in the given slot"
   ::= { usrSS7SlotEntry 6 }

   usrSS7SlotDisconnectToSlot    OBJECT-TYPE
			SYNTAX   INTEGER 
			ACCESS  read-write
            STATUS  mandatory
            DESCRIPTION
                "The Command to connect Hiper Arc to a SS7 channel in the given slot"
   ::= { usrSS7SlotEntry 7 }

	usrSS7ENFASLinkDownCause OBJECT-TYPE
			SYNTAX   INTEGER {
				none(0),
				missingHDM(1),
				lostGWConnection(2),
				pBusError(3),
				manualDisconnect(4)
				}
			ACCESS  read-only
		  STATUS      mandatory
		  DESCRIPTION "The status of the SLAP Connection to the Secondary SS7 gateway."
		  ::= {usrSS7SlotEntry 8 }

	usrSS7SlotStatSBUSXmitPacketsOKCount OBJECT-TYPE
		  SYNTAX      INTEGER
		  ACCESS      read-only
		  STATUS      mandatory
		  DESCRIPTION "the number of successful packets transmitted over the pBus connection."
		  ::= {usrSS7SlotEntry 9}

	usrSS7SlotStatSBUSXmitPacketsFailCount OBJECT-TYPE
		  SYNTAX      INTEGER
		  ACCESS      read-only
		  STATUS      mandatory
		  DESCRIPTION "the number of packets failed to transmit over the pBus connection."
		  ::= {usrSS7SlotEntry 10}

	usrSS7SlotStatSBUSRcvdPacketsOKCount OBJECT-TYPE
		  SYNTAX      INTEGER
		  ACCESS      read-only
		  STATUS      mandatory
		  DESCRIPTION "the number of successful packets received over the pBus connection."
		  ::= {usrSS7SlotEntry 11}

	usrSS7SlotStatSBUSRcvdmitPacketsFailCount OBJECT-TYPE
		  SYNTAX      INTEGER
		  ACCESS      read-only
		  STATUS      mandatory
		  DESCRIPTION "the number of packets rejected by the pBus/Sbus client application."
		  ::= {usrSS7SlotEntry 12}

    usrSS7CountersResetTime    OBJECT-TYPE
            SYNTAX  OCTET STRING (SIZE (0..12))
            ACCESS  read-write
            STATUS  mandatory
            DESCRIPTION
                "set: ignores the string and reset the sbus statistics counters.
								 get: returns the last counter reset time"
   ::= { usrSS7 29 }

   usrSS7GWCountersResetTime    OBJECT-TYPE
            SYNTAX  OCTET STRING (SIZE (12))
            ACCESS  read-write
            STATUS      deprecated
            DESCRIPTION
                "Daily time we reset all the SS7 GW connection  statistics counters.
								This mib is not used right now."
   ::= { usrSS7 30 }

   usrSS7ConnectToGW    OBJECT-TYPE
            SYNTAX  OCTET STRING (SIZE (0..12))
            ACCESS  write-only
            STATUS  mandatory
            DESCRIPTION
                "Command to connect to the  SS7 GW manual mode"
   ::= { usrSS7 31 }

   usrSS7SlapTrace    OBJECT-TYPE
			SYNTAX   INTEGER {
				enable(1),
				disable(0)
				}
			ACCESS  read-write
            STATUS  mandatory
            DESCRIPTION
                "SLAP Side SS7 Trace.  enable(1) disable(2) "
        --CONFIGURABLE
   ::= { usrSS7 32 }

   usrSS7TraceOutput    OBJECT-TYPE
			SYNTAX   INTEGER {
				screen(1),
				syslog(2)
				}
			ACCESS  read-write
            STATUS  mandatory
            DESCRIPTION
                "The place where SS7 Trace output is send to. either to the console or syslog "
        --CONFIGURABLE
   ::= { usrSS7 33 }

   usrSS7DisconnectToGW    OBJECT-TYPE
            SYNTAX  OCTET STRING (SIZE (0..12))
            ACCESS  write-only
            STATUS  mandatory
            DESCRIPTION
                "Command to disconnect the the existing conection to SS7 GW.
				this will tear down all the sbus connections to HDMs "
   ::= { usrSS7 34 }

   usrSS7SendHeartBeat    OBJECT-TYPE
            SYNTAX  OCTET STRING (SIZE (0..12))
            ACCESS  write-only
            STATUS  mandatory
            DESCRIPTION
                "Command to send a heartbeat to the existing conection to SS7 GW."
   ::= { usrSS7 35 }

   usrSS7MissedHeartBeatsCounter    OBJECT-TYPE
            SYNTAX  INTEGER
            ACCESS  read-only
            STATUS  mandatory
            DESCRIPTION
                "Command to send a heartbeat to the existing conection to SS7 GW."
   ::= { usrSS7 36 }

	usrSS7SLAPPrimaryGatewayConnectionStatus OBJECT-TYPE
			SYNTAX   INTEGER {
				up(1),
				down(2),
				connecting(3)
				}
			ACCESS  read-only
		  STATUS      mandatory
		  DESCRIPTION "The status of the SLAP Connection to the Primary SS7 gateway."
		  ::= {usrSS7 37 }

	usrSS7SLAPSecondaryGatewayConnectionStatus OBJECT-TYPE
			SYNTAX   INTEGER {
				up(1),
				down(2),
				connecting(3)
				}
			ACCESS  read-only
		  STATUS      mandatory
		  DESCRIPTION "The status of the SLAP Connection to the Secondary SS7 gateway."
		  ::= {usrSS7 38 }

	usrSS7SLAPPrimaryLinkDownCause OBJECT-TYPE
			SYNTAX   INTEGER {
				none(0),
				heartbeatExpired(1),
				socketError(2),
				physicalLinkCut(3),
				manualDisconect(4)
				}
			ACCESS  read-only
		  STATUS      mandatory
		  DESCRIPTION "The status of the SLAP Connection to the Secondary SS7 gateway."
		  ::= {usrSS7 39 }
	
	usrSS7SLAPSecondaryLinkDownCause OBJECT-TYPE
			SYNTAX   INTEGER {
				none(0),
				heartbeatExpired(1),
				socketError(2),
				physicalLinkCut(3),
				manualDisconect(4)
				}
			ACCESS  read-only
		  STATUS      mandatory
		  DESCRIPTION "The status of the SLAP Connection to the Secondary SS7 gateway."
		  ::= {usrSS7 40 }

	usrSS7SLAPUpTrap OBJECT-TYPE
			SYNTAX   INTEGER {
				enable(1),
				disable(0)
				}
			ACCESS  read-write
		  STATUS      mandatory
		  DESCRIPTION "if enabled sends TRAP each time the SLAP connection
                       to the gateway goes UP."
        --CONFIGURABLE
		  ::= {usrSS7 41 }

	usrSS7SLAPDownTrap OBJECT-TYPE
			SYNTAX   INTEGER {
				enable(1),
				disable(0)
				}
			ACCESS  read-write
		  STATUS      mandatory
		  DESCRIPTION "if enabled sends TRAP each time the SLAP connection 
                       to the gateway goes Down."
        --CONFIGURABLE
		  ::= {usrSS7 42 }

	usrSS7ENFASUpTrap OBJECT-TYPE
			SYNTAX   INTEGER {
				enable(1),
				disable(0)
				}
			ACCESS  read-write
		  STATUS      mandatory
		  DESCRIPTION "if enabled sends TRAP each time the ENFAS connection to the
                       HDM goes Up."
        --CONFIGURABLE
		  ::= {usrSS7 43 }

	usrSS7ENFASDownTrap OBJECT-TYPE
			SYNTAX   INTEGER {
				enable(1),
				disable(0)
				}
			ACCESS  read-write
		  STATUS      mandatory
		  DESCRIPTION "if enabled sends TRAP each time the ENFAS connection to the
                       HDM goes Down."
        --CONFIGURABLE
		  ::= {usrSS7 44 }

	usrSS7DropCallFlag OBJECT-TYPE
			SYNTAX   INTEGER {
				enable(1),
				disable(2)
				}
			ACCESS  read-write
		  STATUS      mandatory
		  DESCRIPTION "if enabled, drops all the calls, if the connection the GW is gone.
                       after the timer expires ."
        --CONFIGURABLE
		  ::= {usrSS7 45 }

	usrSS7DropCallTimer OBJECT-TYPE
			SYNTAX   INTEGER 
			ACCESS  read-write
		  STATUS      mandatory
		  DESCRIPTION "When timer expires drops all the calls, when looses GW connection"
        --CONFIGURABLE
		  ::= {usrSS7 46 }

	usrSS7SLAPGatewayDownTrap TRAP-TYPE
        ENTERPRISE  usrSS7
        VARIABLES   {    
                usrSS7SLAPChassisID,
                usrSS7SLAPgatewayIPAddress,
                usrSS7SLAPgatewayPort,
				usrSS7SLAPPrimaryLinkDownCause
        }
        DESCRIPTION     "This trap is generated when 
			SLAP connection to the SS7 Gateway goes down."
        --#TYPE "Alarm"
        ::= 1

	usrSS7SLAPGatewayUPTrap TRAP-TYPE
        ENTERPRISE  usrSS7
        VARIABLES   {    
                usrSS7SLAPChassisID,
                usrSS7SLAPgatewayIPAddress,
                usrSS7SLAPgatewayPort
        }
        DESCRIPTION     "This trap is generated when 
			SLAP connection to the SS7 Gateway is restored."
        --#TYPE "Alarm"
        ::= 2

	usrSS7ENFASConnectionDownTrap TRAP-TYPE
        ENTERPRISE  usrSS7
        VARIABLES   {    
                usrSS7SLAPChassisID,
                usrSS7Slot,
				usrSS7ENFASLinkDownCause
        }
        DESCRIPTION     "This trap is generated when 
			ENFAS  connection to the HiperDSP slot is Down."
        --#TYPE "Alarm"
        ::= 3

	usrSS7ENFASConnectionUPTrap TRAP-TYPE
        ENTERPRISE  usrSS7
        VARIABLES   {    
                usrSS7SLAPChassisID,
                usrSS7Slot
        }
        DESCRIPTION     "This trap is generated when 
			ENFAS  connection to the HiperDSP slot is restored."
        --#TYPE "Alarm"
        ::= 4

END         -- End USR-SS7-MIB definitions
--
--     usr_betasite.mib -  A template MIB file for Pilgrim MIB modules
--		
