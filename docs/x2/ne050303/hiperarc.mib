	::= { uumFramedRouteEntry 1 }

	uumFramedRouteIpAddress	OBJECT-TYPE
	SYNTAX	IpAddress
	ACCESS	not-accessible
	STATUS	mandatory
	DESCRIPTION
		"The framed routing ip address for the user"
