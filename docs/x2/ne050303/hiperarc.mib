	usrUserManSlotSpanChanOffset	OBJECT-TYPE
	SYNTAX	INTEGER (0..1)
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"Offset to add to modem's reported slot/span/channel
		when reporting this information.
		Default value is 1 for all platforms except
		Positron which uses a default of 0."
     	--CONFIGURABLE
	::= { usrUserManGroup 47 }

	usrUserManHintAssigned	OBJECT-TYPE
	SYNTAX	INTEGER {
			enabled(1),
			disabled(2)
		}
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"Is the hint assigned feature enabled?"
	--CONFIGURABLE
	::= { usrUserManGroup 48 }

    usrUserManAuthorEna    OBJECT-TYPE
    SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "Is remote authorization on or off"
    --CONFIGURABLE
    ::= { usrUserManGroup 49 }

    usrUserManTcpPacketsRx   OBJECT-TYPE
    SYNTAX  Counter
    ACCESS  read-only
    STATUS  mandatory
    DESCRIPTION
        "The number of TCP packets received"
    ::= { usrUserManGroup 50 }

    usrUserManTcpPacketsTx   OBJECT-TYPE
    SYNTAX  Counter
    ACCESS  read-only
    STATUS  mandatory
    DESCRIPTION
        "The number of TCP packets transmitted"
    ::= { usrUserManGroup 51 }
 
-- AAA server table definition.  A Direct-Request host name entry refers
-- to one of the AAA servers in this table.
  
    usrUserManAAAServersTable OBJECT-TYPE
    SYNTAX SEQUENCE OF UumAAAServersEntry
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION
        ""
    ::= { usrUserManGroup 52 }


    uumAAAServersEntry    OBJECT-TYPE
    SYNTAX  UumAAAServersEntry
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION
        ""
    INDEX   { uumAAAServersName, uumAAAServersPref }
    ::= { usrUserManAAAServersTable 1 }

    UumAAAServersEntry ::=
    SEQUENCE {
    uumAAAServersName 
        UsrUserName,
    uumAAAServersPref
        INTEGER,
    uumAAAServerIpAddress
        IpAddress,
    uumAAAServersSecret
        OCTET STRING,
    uumAAAServersPort
        INTEGER,
    uumAAAServersEncryption 
        INTEGER,
    uumAAAServersState
        INTEGER,
    uumAAAServersHostName
        OCTET STRING,
    uumAAAServersPassThru
        INTEGER, 
    uumAAAServersSourcePort
	INTEGER,
    uumAAAServersStatus
        INTEGER,
        uumAAAServersMirrorGroup         INTEGER,
        uumAAAServersSelectionMask       OCTET STRING,  
        uumAAAServersAAAType             INTEGER,
        uumAAAServersProtocol            INTEGER,
        uumAAAServersTimeout             INTEGER,
        uumAAAServersRetransmit          INTEGER,
        uumAAAServersSuccessCount        Counter,
        uumAAAServersFailureCount        Counter,
        uumAAAServersNoResponseCount     Counter,
        uumAAAServersContactInterval     INTEGER,
        uumAAAServersOperationalStatus   INTEGER

    }

    uumAAAServersName  OBJECT-TYPE
    SYNTAX  UsrUserName
    ACCESS  not-accessible      
    STATUS  mandatory
    DESCRIPTION
        "Server name"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 1 }

    uumAAAServersPref  OBJECT-TYPE
    SYNTAX  INTEGER 
    ACCESS  not-accessible      
    STATUS  mandatory
    DESCRIPTION
        "Server preference"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 2 }
    
    uumAAAServerIpAddress OBJECT-TYPE
    SYNTAX  IpAddress
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "The IP address for the server"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 3 }

    uumAAAServersSecret OBJECT-TYPE
    SYNTAX  OCTET STRING (SIZE (1..15))
    ACCESS  write-only
    STATUS  mandatory
    DESCRIPTION 
        "The shared secret between the AAA server and client"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 4 }

    uumAAAServersPort    OBJECT-TYPE
    SYNTAX  INTEGER (1..65535)
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "The port the AAA server listens at"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 5 }

-- Reversed the definition and change to on/off instead of enable/disable
-- which is consistent with similar difinition on other encryption setting  WSFU 9/23/97
    uumAAAServersEncryption   OBJECT-TYPE
    SYNTAX  INTEGER {
                on(1),
                off(2) 
            }
    ACCESS  read-write
    STATUS  mandatory 
    DESCRIPTION
        "Packet body encryption enabled or disabled.  Disabling encryption
         works for TACACS+ clients only.  The entire body will be sent as 
         clear text. Obvious security concern."
    --CONFIGURABLE
    ::= { uumAAAServersEntry 6 }

    uumAAAServersState OBJECT-TYPE
    SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
    ACCESS  read-write
    STATUS  mandatory 
    DESCRIPTION
        "Is the AAA server enable or disabled"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 7 }

    uumAAAServersHostName OBJECT-TYPE
    SYNTAX  OCTET STRING (SIZE (0..240))
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "The name of the AAA host to be resolved by DNS"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 8 }

    uumAAAServersPassThru OBJECT-TYPE
    SYNTAX  INTEGER {
            enabled(1),
            disabled(2)
        }
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "When enabled will allow users access to a domain even if they authentication fails.
         This object is used primarily with the direct request feature."
    --CONFIGURABLE
    ::= { uumAAAServersEntry 9 }

    uumAAAServersSourcePort    OBJECT-TYPE
    SYNTAX  INTEGER (0..65535)
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "The source port the AAA server listens at"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 10 }

    uumAAAServersStatus   OBJECT-TYPE
    SYNTAX  INTEGER {
        delete(1), 
        inactive(2),
        active(3)
        }
    ACCESS  read-write
    STATUS  mandatory 
    DESCRIPTION
        "The status field for delete -- LEAVE THIS AS LAST OBJECT IN TABLE"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 11 }

    uumAAAServersMirrorGroup  OBJECT-TYPE
    SYNTAX  INTEGER  (0..65535)
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "Mirror Group for this server"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 12 }
    
    uumAAAServersSelectionMask OBJECT-TYPE
    SYNTAX  OCTET STRING (SIZE (1..20))
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
    "The Selection mask for Server selection"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 13 }
        
    uumAAAServersAAAType OBJECT-TYPE
        SYNTAX  INTEGER {
                auth(1),
                acco(2) 
            }           
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "AAA Server type. Can be Authentication/Accounting"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 14 } 

    uumAAAServersProtocol OBJECT-TYPE
        SYNTAX  INTEGER {
                tacacsplus(1),
                radius(2)
            }
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "AAA Server Protocol. For now can be TACACS+ or RADIUS"
    --CONFIGURABLE
    ::= { uumAAAServersEntry 15 }

    uumAAAServersTimeout    OBJECT-TYPE
    SYNTAX  INTEGER (0..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Timeout value for trying this server.
                Exceeding the time setting will lead to trying for the
                next server in the table "
        --CONFIGURABLE
        ::= { uumAAAServersEntry 16 }

        uumAAAServersRetransmit    OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                " The retry count or retransmission count for this server
                in the table "
        --CONFIGURABLE
        ::= { uumAAAServersEntry 17 }

        uumAAAServersSuccessCount OBJECT-TYPE
        SYNTAX  Counter
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
        "The number of times radius fails to answer an
                        authentication request"
        ::= { uumAAAServersEntry 18 }

        uumAAAServersFailureCount  OBJECT-TYPE
        SYNTAX  Counter
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
        "The number of times radius fails to answer an
                        authentication request"
        ::= { uumAAAServersEntry 19 }

        uumAAAServersNoResponseCount  OBJECT-TYPE
        SYNTAX  Counter
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
        "The number of times there was a no response from the server
                        for a AAA request "
        ::= { uumAAAServersEntry 20 }

        uumAAAServersContactInterval      OBJECT-TYPE
            SYNTAX  INTEGER
            ACCESS  read-only
            STATUS  mandatory
            DESCRIPTION
           "Number of seconds since the authentication server was last contacted."
                DEFVAL { -1 }
          ::= { uumAAAServersEntry 21 }

        uumAAAServersOperationalStatus      OBJECT-TYPE
            SYNTAX  INTEGER {
                        up(1),
                        down(2)
                }
            ACCESS  read-only
            STATUS  mandatory
            DESCRIPTION
                " Operational Status of Server during AUTH/ACCO "
                DEFVAL { 1 }
          ::= { uumAAAServersEntry 22 }

	usrUserManDirectRequestStatus	OBJECT-TYPE
	SYNTAX	INTEGER {
			enabled(1),
			disabled(2)
		} 
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"Is direct request on or off"
	--CONFIGURABLE
	::= { usrUserManGroup 53 }

    usrUserManDirectRequestDelimiter  OBJECT-TYPE
    SYNTAX  OCTET STRING    (SIZE (1..20))
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "The delimiter string for the direct request service"
    --CONFIGURABLE
    ::= { usrUserManGroup 54 }

    usrUserManDirectRequestTimeout  OBJECT-TYPE
    SYNTAX  INTEGER (0..30)
    ACCESS  read-write
    STATUS  mandatory
    DESCRIPTION
        "Timeout feature for the direct request service"
    --CONFIGURABLE
    ::= { usrUserManGroup 55 }


        usrUserManRadiusVSA     OBJECT-TYPE
        SYNTAX  INTEGER {
                        enabled(1),
                        disabled(2)
                        }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Vendor Specific Attribute for the compatibility of Sprint CISCO Server" 
        --CONFIGURABLE
        ::= { usrUserManGroup 56 }
         
        usrUserManRadiusAcctVSA OBJECT-TYPE
        SYNTAX  INTEGER { 
                        enabled(1),
                        disabled(2)
                        }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Vendor Specific Attribute for the compatibility of Sprint CISCO Server"         
        --CONFIGURABLE
        ::= { usrUserManGroup 57 }

--###===========AAA Domain Table===========
-- AAA Domain table definition.
--      
    usrUserManAAADomainTable OBJECT-TYPE
    SYNTAX SEQUENCE OF UumAAADomainEntry
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION 
        ""
    ::= { usrUserManGroup 67 }
        
 uumAAADomainEntry    OBJECT-TYPE 
    SYNTAX  UumAAADomainEntry
    ACCESS  not-accessible
    STATUS  mandatory
    DESCRIPTION
        ""  
    INDEX   { uumAAADomainName, uumAAADomainAAAType }
    ::= { usrUserManAAADomainTable 1 }
    
    
 UumAAADomainEntry ::=
    SEQUENCE {
    uumAAADomainName            UsrUserName,
    uumAAADomainAAAType         INTEGER,
    uumAAADomainServersUnavail     OCTET STRING,
    uumAAADomainSearchAlg       INTEGER,
    uumAAADomainDNSIpRotation   INTEGER,
    uumAAADomainInterimAccountingInterval INTEGER,
    uumAAADomainMirroring       INTEGER,
    uumAAADomainState            INTEGER,
    uumAAADomainStatus          INTEGER
    }   
        
                        
        uumAAADomainName        OBJECT-TYPE
                SYNTAX UsrUserName
        ACCESS  not-accessible
        STATUS  mandatory
        DESCRIPTION 
                        "The name of the AAA domain "
                --CONFIGURABLE
                ::= { uumAAADomainEntry 1 }
          
        uumAAADomainAAAType  OBJECT-TYPE
                SYNTAX  INTEGER  (1..3)
            ACCESS  not-accessible 
        STATUS  mandatory
            DESCRIPTION  
            "AAA Server type. Can be Authorizing/Accounting/AAA"
                --CONFIGURABLE
                ::= { uumAAADomainEntry 2 }
                
        uumAAADomainServersUnavail      OBJECT-TYPE
                SYNTAX  OCTET STRING (SIZE (0..240))
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Behaviour if servers are unavailable"
                --CONFIGURABLE
                ::= { uumAAADomainEntry 3 }



        uumAAADomainSearchAlg    OBJECT-TYPE
        SYNTAX  INTEGER {
                fall-Through(1),
                round-Robin(2),
                active-server(3),
                preferred(4),
                load-balancing(5)
                }
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Domain Server Search Algorithm"
                --CONFIGURABLE
                ::= { uumAAADomainEntry 4 }

        uumAAADomainDNSIpRotation    OBJECT-TYPE
        SYNTAX  INTEGER {
                yes(1),
                no(2)
                }
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Should this domain be looked up using DNS ? "
                --CONFIGURABLE
                ::= { uumAAADomainEntry 5 }

        uumAAADomainInterimAccountingInterval    OBJECT-TYPE
                SYNTAX  INTEGER (0..65535)
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Checkpoint Interval for looking up this domain.
                Exceeding the time setting will lead to trying for the
                next domain in the table "
                --CONFIGURABLE
                ::= { uumAAADomainEntry 6 }

        uumAAADomainMirroring    OBJECT-TYPE
        SYNTAX  INTEGER {
                yes(1),
                no(2)
                }
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Should this Domain info. be mirrored ? "
                --CONFIGURABLE
            ::= { uumAAADomainEntry 7 }


        uumAAADomainState    OBJECT-TYPE
        SYNTAX  INTEGER {
                enable(1),
                disable(2)
                }
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Is this domain enabled to be used ? "
                --CONFIGURABLE
            ::= { uumAAADomainEntry 8 }

        uumAAADomainStatus    OBJECT-TYPE
                SYNTAX  INTEGER {
                                delete(1),
                                inactive(2),
                                active(3)
                                }
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Is this domain  added or deleted. Leave this last in the table"
                --CONFIGURABLE
            ::= { uumAAADomainEntry 9 }



-- Global default parameters for Domain Information. Also includes
-- DIRECT_REQUEST Settings



        uumAAAGlobalSelectionMask  OBJECT-TYPE
        SYNTAX  OCTET STRING (SIZE (1..64))
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
        "The Selection mask for Server selection"
        --CONFIGURABLE
         ::= { usrUserManGroup 68 }

        uumAAAGlobalServersUnavail OBJECT-TYPE
        SYNTAX  OCTET STRING  (SIZE (0..240))
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Behaviour if servers are unavailable. Action can be
                                DENY, PERMIT or <domain name> "
                --CONFIGURABLE
         ::= { usrUserManGroup 69 }

        uumAAAGlobalSearchAlg     OBJECT-TYPE
        SYNTAX  INTEGER {
                fall-Through(1),
                round-Robin(2),
				active-server(3),
				prefered(4),
				load-Balancing(5)
                }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
        "Domain Server Search Algorithm"
        --CONFIGURABLE
         ::= { usrUserManGroup 70 }

        uumAAAGlobalDNSIpRotation       OBJECT-TYPE
        SYNTAX  INTEGER {
                enabled(1),
                disabled(2)
                }
                ACCESS  read-write
                STATUS  mandatory
                DESCRIPTION
                "Should this domain be looked up using DNS ? "
                --CONFIGURABLE
         ::= { usrUserManGroup 71 }


        uumAAAGlobalMirroring     OBJECT-TYPE
        SYNTAX  INTEGER {
                enabled(1),
                disabled(2)
                }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
        "Should this Domain info. be mirrored ? "
        --CONFIGURABLE
         ::= { usrUserManGroup 73 }
         

        uumAAAGlobalRealmPassword  OBJECT-TYPE
        SYNTAX  OCTET STRING (SIZE (1..15))
        ACCESS  write-only
        STATUS  mandatory
        DESCRIPTION
        "The password for the user send to RADIUS realm directed req case"
        --CONFIGURABLE
         ::= { usrUserManGroup 229 }


-- Pilgrim20 has elements defined in the range through 57 and 
-- 90 through 91.  

	usrUserManReportedPortDensity	OBJECT-TYPE
	SYNTAX	INTEGER (1..256)
	ACCESS	read-write
	STATUS	mandatory
	DESCRIPTION
		"Used as slot multiplier for modem slot
	         when reporting RADIUS NAS-PORT attribute.
	         The reported NAS-PORT attribute for a call is
		 computed as: <slot#> * usrUserManReportedPortDensity +
		              <channel#> + usrUserManSlotSpanChanOffset
	         This can be used to achieve a dense NAS-PORT # mapping for a
		 chassis with uniform modem port density.  Note that it is possible
		 to configure this attribute such that eroneous aliasing of NAS-PORT #s
		 are generated if the ReportPortDensity is set < the systems true port density.
		 Default value is 256."
     	--CONFIGURABLE
	::= { usrUserManGroup 90 }

    usrUserManFillNullAttributes  OBJECT-TYPE
    SYNTAX  INTEGER {
             disabled(0),
             enabled(1)
         }
     ACCESS  read-write
     STATUS  mandatory
     DESCRIPTION
         "This is the switch to enable/disable Filling of Null Attributes
          in Radius Accounting records"
     --CONFIGURABLE
     ::= { usrUserManGroup 91 }

-- Radius enhancements for UUNET follow
 
-- The source port for the authentication servers
 
        usrUserManRadiusSrcPort OBJECT-TYPE
        SYNTAX  INTEGER (1..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The source udp port the primary radius server binds to"
        --CONFIGURABLE
        ::= { usrUserManGroup 92 }
-- The source port for the accounting servers
 
        usrUserManRadiusAcctSrcPort     OBJECT-TYPE
        SYNTAX  INTEGER (1..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The source radius port for the primary accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 93 }
 
-- The tertiary authentication server details
 
        usrUserManRadiusTertiaryIP      OBJECT-TYPE
        SYNTAX  IpAddress
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The tertiary IP address of the RADIUS server"
        --CONFIGURABLE
        ::= { usrUserManGroup 94 }
 
        usrUserManRadiusTertiarySecret  OBJECT-TYPE
        SYNTAX  OCTET STRING    (SIZE (1..15))
        ACCESS  write-only
        STATUS  mandatory
        DESCRIPTION
                "The radius secret for the tertiary server"
        --CONFIGURABLE
        ::= { usrUserManGroup 95 }

        usrUserManRadiusTertiaryPort    OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The udp port the tertiary radius server listens at"
        --CONFIGURABLE
        ::= { usrUserManGroup 96 }
 
-- The algorithm for authentication
 

        usrRadiusAuthAlgorithm  OBJECT-TYPE
        SYNTAX  INTEGER {
                fallthrough(1),
                roundrobin(2),
				activeserver(3),
				prefered(4)
                }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Takes either the Fall-through or Round-robin algorithm
                 for re-tries"
        --CONFIGURABLE
        ::= { usrUserManGroup 97 }
 
-- The USR or UUNET style for attribute values
 
        usrRadiusAttributeStyle OBJECT-TYPE
        SYNTAX  INTEGER {
                standard(1),
                ascend(2),
                mci(4)
                }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
				"Takes STANDARD or ASCEND style for attribute values"
        --CONFIGURABLE
        ::= { usrUserManGroup 98 }
 
-- The Interim accounting interval for checkpoint accounting
 
        usrRadiusInterimAccountingIntervalEnabled       OBJECT-TYPE
        SYNTAX  TruthValue
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Whether checkpoint accounting is enabled"
        DEFVAL  { 1 }
        --CONFIGURABLE
        ::= { usrUserManGroup 99 }
 
        usrRadiusInterimAccountingInterval      OBJECT-TYPE
        SYNTAX  INTEGER (5..3600)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The time intervals when acct. info is sent to the servers"
        --CONFIGURABLE
        ::= { usrUserManGroup 100 }
 
-- Primary server accounting status
 
        usrUserManPrimAcctStatus        OBJECT-TYPE
        SYNTAX  INTEGER {
                        enabled(1),
                        disabled(2)
                }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Is priamary accounting on or off"
        --CONFIGURABLE
        ::= { usrUserManGroup 101 }
 
-- Secondary server accounting status
 
        usrUserManSecAcctStatus OBJECT-TYPE
        SYNTAX  INTEGER {
                        enabled(1),
                        disabled(2)
                }
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "Is secondary accounting on or off"
        --CONFIGURABLE
        ::= { usrUserManGroup 102 }
 
        usrUserManRadiusAcctFirstBackupIP       OBJECT-TYPE
        SYNTAX  IpAddress
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The IP address of the Primary RADIUS First backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 103 }
 
        usrUserManRadiusAcctSecondBackupIP      OBJECT-TYPE
        SYNTAX  IpAddress
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The IP address of the Primary RADIUS Second backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 104 }
 
        usrUserManRadiusAcctAltFirstBackupIP    OBJECT-TYPE
        SYNTAX  IpAddress
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The IP address of the Secondary RADIUS First backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 105 }

        usrUserManRadiusAcctAltSecondBackupIP   OBJECT-TYPE
        SYNTAX  IpAddress
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The IP address of the Secondary RADIUS Second backup accounting
 server"
        --CONFIGURABLE
        ::= { usrUserManGroup 106 }
 
        usrUserManRadiusAcctFirstBackupSecret   OBJECT-TYPE
        SYNTAX  OCTET STRING    (SIZE (1..15))
        ACCESS  write-only
        STATUS  mandatory
        DESCRIPTION
                "The radius secret for the primary first backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 107 }
 
        usrUserManRadiusAcctSecondBackupSecret  OBJECT-TYPE
        SYNTAX  OCTET STRING    (SIZE (1..15))
        ACCESS  write-only
        STATUS  mandatory
        DESCRIPTION
                "The radius secret for the primary second backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 108 }
 
        usrUserManRadiusAcctAltFirstBackupSecret        OBJECT-TYPE
        SYNTAX  OCTET STRING    (SIZE (1..15))
        ACCESS  write-only
        STATUS  mandatory
        DESCRIPTION
                "The radius secret for the secondary first backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 109 }
 
        usrUserManRadiusAcctAltSecondBackupSecret       OBJECT-TYPE
        SYNTAX  OCTET STRING    (SIZE (1..15))
        ACCESS  write-only
        STATUS  mandatory
        DESCRIPTION
                "The radius secret for the secondary second backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 110 }
 
        usrUserManRadiusAcctFirstBackupPort     OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The radius port for the primary first backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 111 }
 
        usrUserManRadiusAcctSecondBackupPort    OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The radius port for the primary second backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 112 }
 
        usrUserManRadiusAcctAltFirstBackupPort  OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The radius port for the secondary first backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 113 }
 
        usrUserManRadiusAcctAltSecondBackupPort OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-write
        STATUS  mandatory
        DESCRIPTION
                "The radius port for the secondary second backup accounting server"
        --CONFIGURABLE
        ::= { usrUserManGroup 114 }
 
        usrUserManRadiusAcctRoundRobinCount     OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The number of times the servers are switched in the primary server group"
        ::= { usrUserManGroup 115 }
 
        usrUserManRadiusAcctAltRoundRobinCount  OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The number of times the servers are switched in the secondary server group"
        ::= { usrUserManGroup 116 }
 
        usrUserManRadiusAcctPacketDiscardCount  OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The number of packets discarded in the primary server group"
        ::= { usrUserManGroup 117 }
 
        usrUserManRadiusAcctAltPacketDiscardCount       OBJECT-TYPE
        SYNTAX  INTEGER (0..65535)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "The number of packets discarded in the secondary server group"
        ::= { usrUserManGroup 118 }

        usrUserManRadiusAcctQueuePercentFull    OBJECT-TYPE
        SYNTAX  INTEGER (0..100)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
                "Percentage of the queue filled in the primary server group"
        ::= { usrUserManGroup 119 }
 
        usrUserManRadiusAcctAltQueuePercentFull OBJECT-TYPE
        SYNTAX  INTEGER (0..100)
        ACCESS  read-only
        STATUS  mandatory
        DESCRIPTION
